{% extends 'base.html.twig' %}

{% block title %}Dépôt-Ligne{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Dépôt-Ligne</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(depot_lignes, 'Dépôt', 'depot.label') }}</th>
                    <th>{{ knp_pagination_sortable(depot_lignes, 'Ligne', 'ligne.label') }}</th>
                    <th>{{ knp_pagination_sortable(depot_lignes, 'Arrivée', 'dl.arrivee') }}</th>
                    <th>{{ knp_pagination_sortable(depot_lignes, 'Fin', 'dl.fin') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for depot_ligne in depot_lignes %}
                <tr>
                    <td>
                        {% if depot_ligne.depot %}
                            <a href="{{ path('app_depot_show', {'id': depot_ligne.depot.id}) }}" class="link-body-emphasis">
                                {{ depot_ligne.depot.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if depot_ligne.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': depot_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ depot_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ depot_ligne.ligne.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ depot_ligne.arrivee ? depot_ligne.arrivee|date('Y-m-d') : '' }}</td>
                    <td>{{ depot_ligne.fin ? depot_ligne.fin|date('Y-m-d') : '' }}</td>
                    <td>
                        <a href="{{ path('app_depot_ligne_show', {'id': depot_ligne.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_depot_ligne_edit', {'id': depot_ligne.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(depot_lignes) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_depot_ligne_new') }}" class="btn btn-primary">Créer nouveau dépôt-ligne</a>
        {% endif %}
    </div>
{% endblock %}
