{% extends 'base.html.twig' %}

{% block title %}DepotLigne{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Dépôt-Ligne</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_depot_ligne_edit', {'id': depot_ligne.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('depot_ligne/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ depot_ligne.id }}</td>
                </tr>
                <tr>
                    <th>Dépôt</th>
                    <td>
                        {% if depot_ligne.depot %}
                            <a href="{{ path('app_depot_show', {'id': depot_ligne.depot.id}) }}" class="link-body-emphasis">
                                {{ depot_ligne.depot.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Ligne</th>
                    <td>
                        {% if depot_ligne.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': depot_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ depot_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ depot_ligne.ligne.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Arrivée</th>
                    <td>{{ depot_ligne.arrivee ? depot_ligne.arrivee|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Fin</th>
                    <td>{{ depot_ligne.fin ? depot_ligne.fin|date('Y-m-d') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_depot_ligne_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
