{% extends 'base.html.twig' %}

{% block title %}Station{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Station</h1>

        <div class="btn-group mb-3" role="group" aria-label="Filtrer par statut">
            {% if actifSelectionne and not inactifSelectionne %}
                <span class="btn btn-sm btn-secondary disabled" title="Au moins un statut doit rester sélectionné">Actives</span>
            {% else %}
                <a href="{{ path('app_station_index', app.request.query.all|merge({'actif': actifSelectionne ? '0' : '1', 'page': null})) }}" class="btn btn-sm {{ actifSelectionne ? 'btn-secondary' : 'btn-outline-secondary' }}">Actives</a>
            {% endif %}
            {% if inactifSelectionne and not actifSelectionne %}
                <span class="btn btn-sm btn-secondary disabled" title="Au moins un statut doit rester sélectionné">Inactives</span>
            {% else %}
                <a href="{{ path('app_station_index', app.request.query.all|merge({'inactif': inactifSelectionne ? '0' : '1', 'page': null})) }}" class="btn btn-sm {{ inactifSelectionne ? 'btn-secondary' : 'btn-outline-secondary' }}">Inactives</a>
            {% endif %}
        </div>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_station_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'une station',
        }) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(stations, 'Label', 's.label') }}</th>
                    <th>{{ knp_pagination_sortable(stations, 'Ville', 's.ville') }}</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for station in stations %}
                <tr>
                    <td>{{ station.label }}</td>
                    <td>{{ station.ville ?? '—' }}</td>
                    <td>
                        {% if station.estActive %}
                            <span class="badge text-bg-success">Active</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Inactive</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_station_show', {'id': station.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_station_edit', {'id': station.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(stations) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_station_new') }}" class="btn btn-primary">Créer nouvelle station</a>
        {% endif %}
    </div>
{% endblock %}
