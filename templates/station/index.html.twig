{% extends 'base.html.twig' %}

{% block title %}Station{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Station</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for station in stations %}
                <tr>
                    <td>{{ station.label }}</td>
                    <td>
                        <a href="{{ path('app_station_show', {'id': station.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        <a href="{{ path('app_station_edit', {'id': station.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_station_new') }}" class="btn btn-primary">Créer nouvelle station</a>
    </div>
{% endblock %}
