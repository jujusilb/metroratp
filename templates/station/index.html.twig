{% extends 'base.html.twig' %}

{% block title %}Station{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Station</h1>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_station_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'une station',
        }) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(stations, 'Label', 's.label') }}</th>
                    <th>{{ knp_pagination_sortable(stations, 'Ville', 's.ville') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for station in stations %}
                <tr>
                    <td>{{ station.label }}</td>
                    <td>{{ station.ville ?? '—' }}</td>
                    <td>
                        <a href="{{ path('app_station_show', {'id': station.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_station_edit', {'id': station.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(stations) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_station_new') }}" class="btn btn-primary">Créer nouvelle station</a>
        {% endif %}
    </div>
{% endblock %}
