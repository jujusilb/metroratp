{% extends 'base.html.twig' %}

{% block title %}Station {{ station.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ station.label }}{% if station.ville %} <small class="text-muted fs-5">({{ station.ville }})</small>{% endif %}</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_station_edit', {'id': station.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('station/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        {% if not station.estActive %}
            <div class="alert alert-secondary">
                <strong>Station inactive.</strong> Raison{{ station.raisons|length > 1 ? 's' : '' }} :
                <ul class="mb-0">
                    {% for raison in station.raisons %}
                        <li><a href="{{ path('app_raison_show', {'id': raison.id}) }}">{{ raison.label }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <p>
            <strong>Plan de secteur :</strong>
            {% if station.plan %}
                <a href="{{ path('app_plan_show', {'id': station.plan.id}) }}">{{ station.plan.secteur }}</a>
            {% else %}
                <span class="text-muted">Non renseigné</span>
            {% endif %}
        </p>
        <p>
            <strong>Pôle d'échange :</strong>
            {% if station.poleEchange %}
                <a href="{{ path('app_pole_echange_show', {'id': station.poleEchange.id}) }}">{{ station.poleEchange.label }}</a>
            {% else %}
                <span class="text-muted">Non renseigné</span>
            {% endif %}
        </p>
        {% if station.accessibilitePmr %}
            <p>
                <strong>Accessibilité PMR :</strong>
                {{ station.accessibilitePmr }}
                {% if station.accessibilitePmrCommentaire %}
                    <span class="text-muted">— {{ station.accessibilitePmrCommentaire }}</span>
                {% endif %}
            </p>
        {% endif %}
        {% if station.zoneTarifaire %}
            <p><strong>Zone tarifaire :</strong> {{ station.zoneTarifaire }}</p>
        {% endif %}

        <h2 class="h5">Dessertes</h2>
        {% if station.dessertes|length > 0 %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Ligne</th>
                            <th>Type</th>
                            <th>Date d'ouverture</th>
                            <th>Style de station</th>
                            <th>Style d'écriture</th>
                            <th>Porte palière</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for desserte in station.dessertes %}
                            <tr>
                                <td>
                                    {% if desserte.ligne %}
                                        <a href="{{ path('app_ligne_show', {'id': desserte.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ desserte.ligne.couleur|default('#6c757d') }};"></span> {{ desserte.ligne.label }}</a>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>{{ desserte.ligne and desserte.ligne.typeTransport ? desserte.ligne.typeTransport.label : '—' }}</td>
                                <td>{{ desserte.premiereOuverture ? desserte.premiereOuverture|date('d/m/Y') : '—' }}</td>
                                <td>{{ desserte.styleStation ? desserte.styleStation.label : '—' }}</td>
                                <td>{{ desserte.styleEcriture ? desserte.styleEcriture.label : '—' }}</td>
                                <td>{{ desserte.datePortePaliere ? desserte.datePortePaliere|date('m/Y') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-muted">Aucune desserte enregistrée pour cette station.</p>
        {% endif %}

        <h2 class="h5 mt-4 d-flex align-items-center gap-2">
            Sorties
            {% if station.sorties|length > 0 %}
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#carte-acces-modal">Carte</button>
            {% endif %}
        </h2>
        {% if station.sorties|length > 0 %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Accès</th>
                            <th>Accessible PMR</th>
                            <th>Marche depuis le quai</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sortie in station.sorties %}
                            <tr>
                                <td>{{ sortie.acces ? sortie.acces.numero : '—' }}</td>
                                <td>
                                    {% if sortie.acces %}
                                        <a href="{{ path('app_acces_show', {'id': sortie.acces.id}) }}" class="link-body-emphasis">
                                            {{ sortie.acces.label }}
                                        </a>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if sortie.acces and sortie.acces.isAccessible %}
                                        <span class="badge text-bg-success">Oui</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">Non</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if sortie.acces and sortie.acces.distanceMarcheMetres %}
                                        {{ sortie.acces.distanceMarcheMetres|round }} m
                                        {% if sortie.acces.tempsMarcheSecondes %}
                                            <span class="text-muted">(~{{ (sortie.acces.tempsMarcheSecondes / 60)|round(0, 'ceil') }} min)</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('app_sortie_show', {'id': sortie.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="modal fade" id="carte-acces-modal" tabindex="-1" aria-labelledby="carte-acces-modal-titre" aria-hidden="true">
                <div class="modal-dialog modal-fullscreen">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="carte-acces-modal-titre">Carte des sorties</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                        </div>
                        <div class="modal-body">
                            <div id="carte-acces" data-donnees="{{ carteAccesJson }}" style="height: 100%;">
                                <div id="carte-acces-map" style="width: 100%; height: 100%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <p class="text-muted">Aucune sortie enregistrée pour cette station.</p>
        {% endif %}

        <h2 class="h5 mt-4">Points de vente à proximité</h2>
        {% if station.pointsDeVente|length > 0 %}
            <ul>
                {% for point_de_vente in station.pointsDeVente %}
                    <li>
                        <a href="{{ path('app_point_de_vente_show', {'id': point_de_vente.id}) }}">{{ point_de_vente.label }}</a>
                        <span class="text-muted">({{ point_de_vente.type }}{% if point_de_vente.adresse %}, {{ point_de_vente.adresse }}{% endif %})</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucun point de vente connu à proximité.</p>
        {% endif %}

        <h2 class="h5 mt-4">À voir à proximité</h2>
        {% if station.pointsInteret|length > 0 %}
            <ul>
                {% for point_interet in station.pointsInteret %}
                    <li>{{ point_interet.label }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucun lieu remarquable connu à proximité.</p>
        {% endif %}

        <h2 class="h5 mt-4">Sanitaires à proximité</h2>
        {% if station.sanitaires|length > 0 %}
            <ul>
                {% for sanitaire in station.sanitaires %}
                    <li>
                        <a href="{{ path('app_sanitaire_show', {'id': sanitaire.id}) }}">{{ sanitaire.localisation ?? 'Toilette publique' }}</a>
                        {% if sanitaire.accessiblePublic %}<span class="badge text-bg-success">Accessible au public</span>{% endif %}
                        {% if sanitaire.accessibilitePmr %}<span class="badge text-bg-info">PMR</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucun sanitaire connu à proximité.</p>
        {% endif %}

        <h2 class="h5 mt-4">Défibrillateurs à proximité</h2>
        {% if station.defibrillateurs|length > 0 %}
            <ul>
                {% for defibrillateur in station.defibrillateurs %}
                    <li>
                        <a href="{{ path('app_defibrillateur_show', {'id': defibrillateur.id}) }}">{{ defibrillateur.localisation }}</a>
                        {% if defibrillateur.complementLocalisation %}<span class="text-muted">({{ defibrillateur.complementLocalisation }})</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucun défibrillateur connu à proximité.</p>
        {% endif %}

        <h2 class="h5 mt-4">Fontaines à eau</h2>
        {% if station.fontainesEau|length > 0 %}
            <ul>
                {% for fontaine_eau in station.fontainesEau %}
                    <li>
                        <a href="{{ path('app_fontaine_eau_show', {'id': fontaine_eau.id}) }}">{{ fontaine_eau.nomAccesProche ?? fontaine_eau.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune fontaine à eau connue.</p>
        {% endif %}

        <h2 class="h5 mt-4">Sanisettes publiques à proximité</h2>
        {% if station.sanisettesPubliques|length > 0 %}
            <ul>
                {% for sanisette in station.sanisettesPubliques %}
                    <li>
                        <a href="{{ path('app_sanisette_publique_show', {'id': sanisette.id}) }}">{{ sanisette.adresse }}</a>
                        {% if sanisette.accesPmr %}<span class="badge text-bg-info">PMR</span>{% endif %}
                        {% if sanisette.statut != 'En service' %}<span class="badge text-bg-secondary">{{ sanisette.statut }}</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune sanisette publique connue à proximité.</p>
        {% endif %}

        <a href="{{ path('app_station_index') }}" class="btn btn-secondary mt-4">Retour à la liste</a>
    </div>
{% endblock %}
