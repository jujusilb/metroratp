{% extends 'base.html.twig' %}

{% block title %}Document {{ document.nom }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ document.nom }}</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_document_ligne_edit', {'id': document.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('document_ligne/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Ligne</th>
                    <td>
                        {% if document.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': document.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ document.ligne.couleur|default('#6c757d') }};"></span> {{ document.ligne.label }}</a>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>{{ document.type }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5">Document</h2>
        {{ include('tools/visionneuse_pdf.html.twig', {'url': document.url}) }}

        <a href="{{ path('app_document_ligne_index') }}" class="btn btn-secondary mt-4">Retour à la liste</a>
    </div>
{% endblock %}
