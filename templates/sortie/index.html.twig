{% extends 'base.html.twig' %}

{% block title %}Sortie{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Sortie</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(sorties, 'Station', 'station.label') }}</th>
                    <th>{{ knp_pagination_sortable(sorties, 'Accès', 'acces.numero') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for sortie in sorties %}
                <tr>
                    <td>
                        {% if sortie.station %}
                            <a href="{{ path('app_station_show', {'id': sortie.station.id}) }}" class="link-body-emphasis">
                                {{ sortie.station.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if sortie.acces %}
                            <a href="{{ path('app_acces_show', {'id': sortie.acces.id}) }}" class="link-body-emphasis">
                                {{ sortie.acces.numero }} — {{ sortie.acces.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_sortie_show', {'id': sortie.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_sortie_edit', {'id': sortie.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(sorties) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_sortie_new') }}" class="btn btn-primary">Créer nouvelle sortie</a>
        {% endif %}
    </div>
{% endblock %}
