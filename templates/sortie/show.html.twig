{% extends 'base.html.twig' %}

{% block title %}Sortie{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Sortie</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ sortie.id }}</td>
                </tr>
                <tr>
                    <th>Accès</th>
                    <td>{{ sortie.acces ? sortie.acces.label : '—' }}</td>
                </tr>
                <tr>
                    <th>Station</th>
                    <td>{{ sortie.station ? sortie.station.label : '—' }}</td>
                </tr>
            </tbody>
        </table>

        <div class="d-flex gap-2">
            <a href="{{ path('app_sortie_index') }}" class="btn btn-secondary">Retour à la liste</a>
            <a href="{{ path('app_sortie_edit', {'id': sortie.id}) }}" class="btn btn-warning">Modifier</a>
        </div>

        {{ include('sortie/_delete_form.html.twig') }}
    </div>
{% endblock %}
