{% extends 'base.html.twig' %}

{% block title %}Sortie{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Sortie</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_sortie_edit', {'id': sortie.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('sortie/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ sortie.id }}</td>
                </tr>
                <tr>
                    <th>Accès</th>
                    <td>{{ sortie.acces ? sortie.acces.label : '—' }}</td>
                </tr>
                <tr>
                    <th>Station</th>
                    <td>{{ sortie.station ? sortie.station.label : '—' }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_sortie_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
