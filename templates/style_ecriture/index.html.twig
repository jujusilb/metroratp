{% extends 'base.html.twig' %}

{% block title %}Styles{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Styles</h1>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_style_ecriture_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'un style',
        }) }}
        {{ include('tools/_onglets.html.twig', {onglets: [
            {label: 'Station', route: 'app_style_station_index', actif: false},
            {label: 'Accès', route: 'app_style_acces_index', actif: false},
            {label: 'Écriture', route: 'app_style_ecriture_index', actif: true},
        ]}) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(style_ecritures, 'Label', 's.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for style_ecriture in style_ecritures %}
                <tr>
                    <td>{{ style_ecriture.label }}</td>
                    <td>
                        <a href="{{ path('app_style_ecriture_show', {'id': style_ecriture.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_style_ecriture_edit', {'id': style_ecriture.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(style_ecritures) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_style_ecriture_new') }}" class="btn btn-primary">Créer nouveau style d'écriture</a>
        {% endif %}
    </div>
{% endblock %}
