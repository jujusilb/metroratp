{% extends 'base.html.twig' %}

{% block title %}StyleStation{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Style de station</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ style_station.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ style_station.label }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Dessertes de ce style</h2>

        {% if style_station.dessertes|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Station</th>
                        <th>Ligne</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for desserte in style_station.dessertes %}
                    <tr>
                        <td>
                            {% if desserte.station %}
                                <a href="{{ path('app_station_show', {'id': desserte.station.id}) }}" class="link-body-emphasis">
                                    {{ desserte.station.label }}
                                </a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if desserte.ligne %}
                                <a href="{{ path('app_ligne_show', {'id': desserte.ligne.id}) }}" class="ligne-badge-sm" style="background-color: {{ desserte.ligne.couleur|default('#6c757d') }};">
                                    {{ desserte.ligne.label }}
                                </a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if desserte.ouverte %}
                                <span class="badge text-bg-success">Ouverte</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Fermée</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_desserte_show', {'id': desserte.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune desserte enregistrée pour ce style.</p>
        {% endif %}

        <div class="d-flex gap-2">
            <a href="{{ path('app_style_station_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_style_station_edit', {'id': style_station.id}) }}" class="btn btn-warning">Modifier</a>
            {% endif %}
        </div>

        {{ include('style_station/_delete_form.html.twig') }}
    </div>
{% endblock %}
