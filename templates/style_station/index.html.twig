{% extends 'base.html.twig' %}

{% block title %}Style de station{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Style de station</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for style_station in style_stations %}
                <tr>
                    <td>{{ style_station.label }}</td>
                    <td>
                        <a href="{{ path('app_style_station_show', {'id': style_station.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        <a href="{{ path('app_style_station_edit', {'id': style_station.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_style_station_new') }}" class="btn btn-primary">Créer nouveau style de station</a>
    </div>
{% endblock %}
