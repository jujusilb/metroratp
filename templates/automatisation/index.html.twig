{% extends 'base.html.twig' %}

{% block title %}Automatisation{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Automatisation</h1>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_automatisation_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'un palier',
        }) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(automatisations, 'Label', 'a.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for automatisation in automatisations %}
                <tr>
                    <td>{{ automatisation.label }}</td>
                    <td>
                        <a href="{{ path('app_automatisation_show', {'id': automatisation.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_automatisation_edit', {'id': automatisation.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(automatisations) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_automatisation_new') }}" class="btn btn-primary">Créer nouveau palier d'automatisation</a>
        {% endif %}
    </div>
{% endblock %}
