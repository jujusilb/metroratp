{% if is_granted('ROLE_ADMIN') %}
<form method="post" action="{{ path('app_automatisation_delete', {'id': automatisation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ automatisation.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
{% endif %}
