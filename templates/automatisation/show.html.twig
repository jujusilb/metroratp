{% extends 'base.html.twig' %}

{% block title %}Automatisation{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Automatisation</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ automatisation.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ automatisation.label }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Lignes ayant atteint ce palier</h2>

        {% if automatisation.automatisationLignes|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Ligne</th>
                        <th>Date de mise en place</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for automatisation_ligne in automatisation.automatisationLignes %}
                    <tr>
                        <td>
                            {% if automatisation_ligne.ligne %}
                                <a href="{{ path('app_ligne_show', {'id': automatisation_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ automatisation_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ automatisation_ligne.ligne.label }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ automatisation_ligne.dateDeMiseEnPlace ? automatisation_ligne.dateDeMiseEnPlace|date('d/m/Y') : '' }}</td>
                        <td>
                            <a href="{{ path('app_automatisation_ligne_show', {'id': automatisation_ligne.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune ligne n'a encore atteint ce palier.</p>
        {% endif %}

        <div class="d-flex gap-2">
            <a href="{{ path('app_automatisation_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_automatisation_edit', {'id': automatisation.id}) }}" class="btn btn-warning">Modifier</a>
            {% endif %}
        </div>

        {{ include('automatisation/_delete_form.html.twig') }}
    </div>
{% endblock %}
