{% extends 'base.html.twig' %}

{% block title %}Ligne {{ ligne.label }}{% endblock %}

{% macro renderSegment(segment) %}
    <ul class="list-group list-group-flush shadow-sm rounded-3 mb-3 parcours-list">
        {% for station in segment.stations %}
            <li class="list-group-item list-group-item-action border-start border-4 ps-3 d-flex flex-wrap align-items-center gap-2{{ station.rejoint ? ' bg-light fst-italic text-muted' : '' }}">
                {% if station.correspondances|length > 0 %}
                    <span class="d-flex flex-wrap gap-2">
                        {% for correspondance in station.correspondances %}
                            <a href="{{ path('app_ligne_show', {'id': correspondance.ligneId}) }}" class="link-body-emphasis text-decoration-none" title="Correspondance ligne {{ correspondance.label }}"><span class="pastille-ligne" style="--ligne-couleur: {{ correspondance.couleur|default('#6c757d') }};"></span> {{ correspondance.label }}</a>
                        {% endfor %}
                    </span>
                {% endif %}
                {% if station.stationId %}
                    <a href="{{ path('app_station_show', {'id': station.stationId}) }}" class="link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover">{{ station.label }}</a>
                {% else %}
                    <span>{{ station.label }}</span>
                {% endif %}
                {% if station.rejoint %}
                    <span class="badge rounded-pill text-bg-secondary ms-auto" title="Rejoint la ligne principale">{{ station.varianteMaillage ?? 'rejoint la ligne principale' }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
    {% if segment.branches|length > 0 %}
        <div class="row g-3 mb-3">
            {% for branche in segment.branches %}
                <div class="col-md">
                    {{ _self.renderSegment(branche) }}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <span><span class="pastille-ligne" style="--ligne-couleur: {{ ligne.couleur|default('#6c757d') }};"></span> {{ ligne.label }}</span>
                <h1 class="mb-0">Ligne {{ ligne.label }}</h1>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_ligne_edit', {'id': ligne.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('ligne/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <p class="text-muted">
            {{ ligne.nombreStations }} station{{ ligne.nombreStations > 1 ? 's' : '' }}
            {% if ligne.typeTransport %} · {{ ligne.typeTransport.label }}{% endif %}
            {% if ligne.gestionnaire %} · {{ ligne.gestionnaire.label }}{% endif %}
            {% if ligne.dateAutomatisationTotale %} · <span class="badge text-bg-success">Automatique depuis {{ ligne.dateAutomatisationTotale|date('d/m/Y') }}</span>{% endif %}
        </p>

        <div class="parcours" style="--ligne-couleur: {{ ligne.couleur|default('#6c757d') }};">
            {% set segments = ligne.parcoursSegments %}
            {% if segments|length > 0 %}
                {% for segment in segments %}
                    {{ _self.renderSegment(segment) }}
                {% endfor %}
            {% else %}
                <p class="text-muted">Parcours non disponible pour cette ligne.</p>
            {% endif %}
        </div>

        {% if ligne.documents|length > 0 %}
            <h2 class="h5 mt-4">Horaires et plans</h2>
            <ul>
                {% for document in ligne.documents %}
                    <li><a href="{{ path('app_document_ligne_show', {'id': document.id}) }}">{{ document.type }} — {{ document.nom }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}

        <a href="{{ path('app_ligne_index') }}" class="btn btn-secondary mt-4">Retour à la liste</a>
    </div>
{% endblock %}
