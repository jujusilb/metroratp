{% extends 'base.html.twig' %}

{% block title %}Ligne{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Ligne</h1>

        {{ include('tools/filtre_liste.html.twig', {
            'modesSelectionnes': modesSelectionnes,
            'recherche': recherche,
            'route': 'app_ligne_index',
            'libelleRecherche': 'une ligne',
            'placeholderRecherche': 'Numéro ou nom de ligne...',
            'gestionnaires': gestionnaires,
            'gestionnairesSelectionnes': gestionnairesSelectionnes,
            'avecTroncons': avecTroncons,
        }) }}

        <p class="text-muted small">{{ lignes.getTotalItemCount }} ligne{{ lignes.getTotalItemCount > 1 ? 's' : '' }}</p>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(lignes, 'Label', 'l.label') }}</th>
                    <th>{{ knp_pagination_sortable(lignes, 'Type', 'tt.label') }}</th>
                    <th>{{ knp_pagination_sortable(lignes, 'Gestionnaire', 'g.label') }}</th>
                    <th>Terminus</th>
                    <th>Nb stations</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for ligne in lignes %}
                <tr>
                    <td>
                        {% if ligne.couleur %}<span class="pastille-ligne" style="--ligne-couleur: {{ ligne.couleur }};"></span>{% endif %}
                        {{ ligne.label }}
                    </td>
                    <td>{{ ligne.typeTransport ? ligne.typeTransport.label : '—' }}</td>
                    <td>{{ ligne.gestionnaire ? ligne.gestionnaire.label : '—' }}</td>
                    <td>
                        {% if ligne.terminusLabels|length > 0 %}
                            {{ ligne.terminusLabels|join(' ↔ ') }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ ligne.nombreStations }}</td>
                    <td>
                        <a href="{{ path('app_ligne_show', {'id': ligne.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_ligne_edit', {'id': ligne.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td colspan="6" class="pt-0 pb-2 border-top-0">
                        <small class="text-muted">
                            Villes :
                            {% if villesParLigne[ligne.id] is defined and villesParLigne[ligne.id]|length > 0 %}
                                {{ villesParLigne[ligne.id]|join(', ') }}
                            {% else %}
                                —
                            {% endif %}
                        </small>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="d-flex justify-content-center mb-3">
            {{ knp_pagination_render(lignes) }}
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_ligne_new') }}" class="btn btn-primary">Créer nouvelle ligne</a>
        {% endif %}
    </div>
{% endblock %}
