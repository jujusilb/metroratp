{% extends 'base.html.twig' %}

{% block title %}Ligne{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Ligne</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Terminus</th>
                    <th>Nb stations</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for ligne in lignes %}
                <tr>
                    <td>
                        {% if ligne.couleur %}<span class="badge" style="background-color: {{ ligne.couleur }};">&nbsp;</span>{% endif %}
                        {{ ligne.label }}
                    </td>
                    <td>
                        {% if ligne.terminusLabels|length > 0 %}
                            {{ ligne.terminusLabels|join(' ↔ ') }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ ligne.nombreStations }}</td>
                    <td>
                        <a href="{{ path('app_ligne_show', {'id': ligne.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_ligne_edit', {'id': ligne.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_ligne_new') }}" class="btn btn-primary">Créer nouvelle ligne</a>
        {% endif %}
    </div>
{% endblock %}
