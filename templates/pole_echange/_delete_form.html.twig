{% if is_granted('ROLE_ADMIN') %}
<form method="post" action="{{ path('app_pole_echange_delete', {'id': pole_echange.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pole_echange.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
{% endif %}
