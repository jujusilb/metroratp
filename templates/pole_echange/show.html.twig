{% extends 'base.html.twig' %}

{% block title %}Pôle d'échange {{ pole_echange.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ pole_echange.label }}</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_pole_echange_edit', {'id': pole_echange.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('pole_echange/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <h2 class="h5">Stations ({{ pole_echange.stations|length }})</h2>
        {% if pole_echange.stations|length > 0 %}
            <ul class="list-unstyled">
                {% for station in pole_echange.stations %}
                    {% set lignesStructurantes = station.dessertes|filter(d => d.ligne and d.ligne.typeTransport and d.ligne.typeTransport.label != 'Bus') %}
                    <li class="mb-2">
                        <a href="{{ path('app_station_show', {'id': station.id}) }}">{{ station.label }}</a>{% if station.ville %} <span class="text-muted">({{ station.ville }})</span>{% endif %}
                        {% if lignesStructurantes|length > 0 %}
                            <div class="d-flex flex-wrap column-gap-3 row-gap-1 mt-1">
                                {% for desserte in lignesStructurantes %}
                                    <a href="{{ path('app_ligne_show', {'id': desserte.ligne.id}) }}" class="link-body-emphasis text-decoration-none small"><span class="pastille-ligne" style="--ligne-couleur: {{ desserte.ligne.couleur|default('#6c757d') }};"></span> {{ desserte.ligne.label }}</a>
                                {% endfor %}
                            </div>
                        {% else %}
                            <span class="badge text-bg-light text-muted border ms-1">Bus uniquement</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune station assignée à ce pôle pour l'instant.</p>
        {% endif %}

        <a href="{{ path('app_pole_echange_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
