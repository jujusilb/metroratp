{% extends 'base.html.twig' %}

{% block title %}Raisons d'inactivité{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Raisons d'inactivité</h1>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_raison_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'une raison',
        }) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(raisons, 'Label', 'r.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for raison in raisons %}
                <tr>
                    <td>{{ raison.label }}</td>
                    <td>
                        <a href="{{ path('app_raison_show', {'id': raison.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_raison_edit', {'id': raison.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(raisons) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_raison_new') }}" class="btn btn-primary">Créer nouvelle raison</a>
        {% endif %}
    </div>
{% endblock %}
