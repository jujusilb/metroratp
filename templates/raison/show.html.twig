{% extends 'base.html.twig' %}

{% block title %}Raison{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Raison d'inactivité</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_raison_edit', {'id': raison.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('raison/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ raison.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ raison.label }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Stations concernées</h2>

        {% if raison.stations|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Station</th>
                        <th>Ville</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for station in raison.stations %}
                    <tr>
                        <td>
                            <a href="{{ path('app_station_show', {'id': station.id}) }}" class="link-body-emphasis">
                                {{ station.label }}
                            </a>
                        </td>
                        <td>{{ station.ville ?? '—' }}</td>
                        <td>
                            <a href="{{ path('app_station_show', {'id': station.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune station rattachée à cette raison.</p>
        {% endif %}

        <a href="{{ path('app_raison_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
