{% extends 'base.html.twig' %}

{% block title %}Types de transport{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Types de transport</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(type_transports, 'Label', 't.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for type_transport in type_transports %}
                <tr>
                    <td>{{ type_transport.label }}</td>
                    <td>
                        <a href="{{ path('app_type_transport_show', {'id': type_transport.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_type_transport_edit', {'id': type_transport.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(type_transports) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_type_transport_new') }}" class="btn btn-primary">Créer nouveau type de transport</a>
        {% endif %}
    </div>
{% endblock %}
