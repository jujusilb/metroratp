{% extends 'base.html.twig' %}

{% block title %}Projet {{ projet_arret.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ projet_arret.label }}</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_projet_arret_edit', {'id': projet_arret.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('projet_arret/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Projet</th>
                    <td>{{ projet_arret.nomProjet }}</td>
                </tr>
                <tr>
                    <th>Opération</th>
                    <td>{{ projet_arret.operation ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Nature</th>
                    <td>{{ projet_arret.nature ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Mode</th>
                    <td>{{ projet_arret.mode ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Statut</th>
                    <td>{{ projet_arret.statut ?? '—' }} <span class="text-muted small">(échelle IDFM 1 = études préalables, 10 = mise en service)</span></td>
                </tr>
                <tr>
                    <th>Phase</th>
                    <td>{{ projet_arret.phase ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Type d'opération</th>
                    <td>
                        {% if projet_arret.creation %}<span class="badge text-bg-success me-1">Création</span>{% endif %}
                        {% if projet_arret.prolongement %}<span class="badge text-bg-info me-1">Prolongement</span>{% endif %}
                        {% if projet_arret.amelioration %}<span class="badge text-bg-secondary me-1">Amélioration</span>{% endif %}
                        {% if projet_arret.terminus %}<span class="badge text-bg-warning me-1">Terminus</span>{% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Coordonnées</th>
                    <td>
                        <a href="https://www.openstreetmap.org/?mlat={{ projet_arret.latitude }}&mlon={{ projet_arret.longitude }}#map=17/{{ projet_arret.latitude }}/{{ projet_arret.longitude }}" target="_blank" rel="noopener">
                            {{ projet_arret.latitude }}, {{ projet_arret.longitude }}
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_projet_arret_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
