{% extends 'base.html.twig' %}

{% block title %}MaterielLigne{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Matériel-Ligne</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_materiel_ligne_edit', {'id': materiel_ligne.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('materiel_ligne/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ materiel_ligne.id }}</td>
                </tr>
                <tr>
                    <th>Matériel</th>
                    <td>
                        {% if materiel_ligne.materiel %}
                            <a href="{{ path('app_materiel_show', {'id': materiel_ligne.materiel.id}) }}" class="link-body-emphasis">
                                {{ materiel_ligne.materiel.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Ligne</th>
                    <td>
                        {% if materiel_ligne.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': materiel_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ materiel_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ materiel_ligne.ligne.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Arrivée</th>
                    <td>{{ materiel_ligne.arrivee ? materiel_ligne.arrivee|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Fin</th>
                    <td>{{ materiel_ligne.fin ? materiel_ligne.fin|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Effectif</th>
                    <td>{{ materiel_ligne.effectif ?? '' }}</td>
                </tr>
                <tr>
                    <th>Effectif (date du relevé)</th>
                    <td>{{ materiel_ligne.effectifDate ? materiel_ligne.effectifDate|date('Y-m-d') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_materiel_ligne_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
