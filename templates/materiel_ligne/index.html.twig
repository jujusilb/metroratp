{% extends 'base.html.twig' %}

{% block title %}Matériel-Ligne{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Matériel-Ligne</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(materiel_lignes, 'Matériel', 'materiel.label') }}</th>
                    <th>{{ knp_pagination_sortable(materiel_lignes, 'Ligne', 'ligne.label') }}</th>
                    <th>{{ knp_pagination_sortable(materiel_lignes, 'Arrivée', 'ml.arrivee') }}</th>
                    <th>{{ knp_pagination_sortable(materiel_lignes, 'Fin', 'ml.fin') }}</th>
                    <th>Effectif</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for materiel_ligne in materiel_lignes %}
                <tr>
                    <td>
                        {% if materiel_ligne.materiel %}
                            <a href="{{ path('app_materiel_show', {'id': materiel_ligne.materiel.id}) }}" class="link-body-emphasis">
                                {{ materiel_ligne.materiel.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if materiel_ligne.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': materiel_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ materiel_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ materiel_ligne.ligne.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ materiel_ligne.arrivee ? materiel_ligne.arrivee|date('Y-m-d') : '' }}</td>
                    <td>{{ materiel_ligne.fin ? materiel_ligne.fin|date('Y-m-d') : '' }}</td>
                    <td>
                        {% if materiel_ligne.effectif %}
                            {{ materiel_ligne.effectif }}{{ materiel_ligne.effectifDate ? ' (au ' ~ materiel_ligne.effectifDate|date('d/m/Y') ~ ')' : '' }}
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_materiel_ligne_show', {'id': materiel_ligne.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_materiel_ligne_edit', {'id': materiel_ligne.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(materiel_lignes) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_materiel_ligne_new') }}" class="btn btn-primary">Créer nouveau matériel-ligne</a>
        {% endif %}
    </div>
{% endblock %}
