{% extends 'base.html.twig' %}

{% block title %}Carte du réseau{% endblock %}

{% block body %}
    <div class="container-fluid px-4 py-4">
        <h1 class="mb-3">Carte du réseau</h1>
        <p class="text-muted small mb-2">
            Toutes les stations d'Île-de-France. Survolez une station pour voir les lignes qui la desservent ; survolez une ligne dans la bulle pour prévisualiser son tracé, cliquez dessus pour le fixer (clic sur la carte pour l'effacer).
        </p>
        <div id="carte-reseau-filtres" class="d-flex flex-wrap gap-3 mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" data-bucket="metro" id="carte-filtre-metro" checked>
                <label class="form-check-label" for="carte-filtre-metro">Métro</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" data-bucket="rer" id="carte-filtre-rer" checked>
                <label class="form-check-label" for="carte-filtre-rer">RER</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" data-bucket="tram" id="carte-filtre-tram" checked>
                <label class="form-check-label" for="carte-filtre-tram">Tramway</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" data-bucket="bus" id="carte-filtre-bus" checked>
                <label class="form-check-label" for="carte-filtre-bus">Bus</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" data-bucket="autres" id="carte-filtre-autres" checked>
                <label class="form-check-label" for="carte-filtre-autres">Autres (train, funiculaire...)</label>
            </div>
        </div>
        <div id="carte-reseau" data-donnees="{{ donneesJson }}" data-trace-url="{{ path('app_ligne_trace', {'id': 0}) }}">
            <div id="carte-reseau-map" style="width: 100%; height: 75vh; border: 1px solid #dee2e6; border-radius: 6px;"></div>
        </div>
    </div>
{% endblock %}
