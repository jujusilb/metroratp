{% extends 'base.html.twig' %}

{% block title %}Dépôt-Gestionnaire{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Dépôt-Gestionnaire</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(depot_gestionnaires, 'Dépôt', 'depot.label') }}</th>
                    <th>{{ knp_pagination_sortable(depot_gestionnaires, 'Gestionnaire', 'gestionnaire.label') }}</th>
                    <th>{{ knp_pagination_sortable(depot_gestionnaires, 'Arrivée', 'dg.arrivee') }}</th>
                    <th>{{ knp_pagination_sortable(depot_gestionnaires, 'Fin', 'dg.fin') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for depot_gestionnaire in depot_gestionnaires %}
                <tr>
                    <td>
                        {% if depot_gestionnaire.depot %}
                            <a href="{{ path('app_depot_show', {'id': depot_gestionnaire.depot.id}) }}" class="link-body-emphasis">
                                {{ depot_gestionnaire.depot.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if depot_gestionnaire.gestionnaire %}
                            <a href="{{ path('app_gestionnaire_show', {'id': depot_gestionnaire.gestionnaire.id}) }}" class="link-body-emphasis">
                                {{ depot_gestionnaire.gestionnaire.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ depot_gestionnaire.arrivee ? depot_gestionnaire.arrivee|date('Y-m-d') : '' }}</td>
                    <td>{{ depot_gestionnaire.fin ? depot_gestionnaire.fin|date('Y-m-d') : '' }}</td>
                    <td>
                        <a href="{{ path('app_depot_gestionnaire_show', {'id': depot_gestionnaire.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_depot_gestionnaire_edit', {'id': depot_gestionnaire.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(depot_gestionnaires) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_depot_gestionnaire_new') }}" class="btn btn-primary">Créer nouveau dépôt-gestionnaire</a>
        {% endif %}
    </div>
{% endblock %}
