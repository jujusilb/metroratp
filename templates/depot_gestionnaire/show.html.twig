{% extends 'base.html.twig' %}

{% block title %}DepotGestionnaire{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Dépôt-Gestionnaire</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_depot_gestionnaire_edit', {'id': depot_gestionnaire.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('depot_gestionnaire/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ depot_gestionnaire.id }}</td>
                </tr>
                <tr>
                    <th>Dépôt</th>
                    <td>
                        {% if depot_gestionnaire.depot %}
                            <a href="{{ path('app_depot_show', {'id': depot_gestionnaire.depot.id}) }}" class="link-body-emphasis">
                                {{ depot_gestionnaire.depot.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Gestionnaire</th>
                    <td>
                        {% if depot_gestionnaire.gestionnaire %}
                            <a href="{{ path('app_gestionnaire_show', {'id': depot_gestionnaire.gestionnaire.id}) }}" class="link-body-emphasis">
                                {{ depot_gestionnaire.gestionnaire.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Arrivée</th>
                    <td>{{ depot_gestionnaire.arrivee ? depot_gestionnaire.arrivee|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Fin</th>
                    <td>{{ depot_gestionnaire.fin ? depot_gestionnaire.fin|date('Y-m-d') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_depot_gestionnaire_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
