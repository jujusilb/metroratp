{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Utilisateurs</h1>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_utilisateur_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'un utilisateur',
        }) }}

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>{{ knp_pagination_sortable(utilisateurs, "Nom d'utilisateur", 'u.username') }}</th>
                        <th>{{ knp_pagination_sortable(utilisateurs, 'Email', 'u.email') }}</th>
                        <th>{{ knp_pagination_sortable(utilisateurs, 'Nom complet', 'u.nom') }}</th>
                        <th>{{ knp_pagination_sortable(utilisateurs, 'Ville', 'u.ville') }}</th>
                        <th>Rôle</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for utilisateur in utilisateurs %}
                    <tr>
                        <td>{{ utilisateur.username }}</td>
                        <td>{{ utilisateur.email }}</td>
                        <td>
                            {% if utilisateur.prenom or utilisateur.nom %}
                                {{ [utilisateur.prenom, utilisateur.nom]|filter(v => v)|join(' ') }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ utilisateur.ville|default('—') }}</td>
                        <td>
                            {% if 'ROLE_SUPERADMIN' in utilisateur.roles %}
                                <span class="badge text-bg-dark">Super-administrateur</span>
                            {% elseif 'ROLE_ADMIN' in utilisateur.roles %}
                                <span class="badge text-bg-danger">Administrateur</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Utilisateur</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_utilisateur_show', {'id': utilisateur.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {{ knp_pagination_render(utilisateurs) }}

        <a href="{{ path('app_utilisateur_new') }}" class="btn btn-primary">Créer nouvel utilisateur</a>
    </div>
{% endblock %}
