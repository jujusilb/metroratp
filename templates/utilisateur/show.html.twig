{% extends 'base.html.twig' %}

{% block title %}Utilisateur {{ utilisateur.username }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">
            {{ utilisateur.username }}
            {% if 'ROLE_SUPERADMIN' in utilisateur.roles %}
                <span class="badge text-bg-dark align-middle">Super-administrateur</span>
            {% elseif 'ROLE_ADMIN' in utilisateur.roles %}
                <span class="badge text-bg-danger align-middle">Administrateur</span>
            {% endif %}
        </h1>

        <table class="table w-auto">
            <tbody>
                <tr>
                    <th>Email</th>
                    <td>{{ utilisateur.email }}</td>
                </tr>
                <tr>
                    <th>Prénom</th>
                    <td>{{ utilisateur.prenom|default('—') }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ utilisateur.nom|default('—') }}</td>
                </tr>
                <tr>
                    <th>Téléphone</th>
                    <td>{{ utilisateur.telephone|default('—') }}</td>
                </tr>
                <tr>
                    <th>Adresse</th>
                    <td>
                        {% if utilisateur.adresseLigne1 or utilisateur.adresseLigne2 or utilisateur.codePostal or utilisateur.ville %}
                            {{ utilisateur.adresseLigne1 }}<br>
                            {% if utilisateur.adresseLigne2 %}{{ utilisateur.adresseLigne2 }}<br>{% endif %}
                            {{ utilisateur.codePostal }} {{ utilisateur.ville }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="mt-4 d-flex gap-2">
            <a href="{{ path('app_utilisateur_index') }}" class="btn btn-secondary">Retour à la liste</a>
            <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn btn-warning">Modifier</a>
        </div>

        {{ include('utilisateur/_delete_form.html.twig') }}
    </div>
{% endblock %}
