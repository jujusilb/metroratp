{% extends 'base.html.twig' %}

{% block title %}Statut {{ statut_tache.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ statut_tache.label }}</h1>
            <div class="d-flex gap-2">
                <a href="{{ path('app_statut_tache_edit', {'id': statut_tache.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                {{ include('statut_tache/_delete_form.html.twig') }}
            </div>
        </div>

        <p class="text-muted">{{ statut_tache.taches|length }} tâche(s) avec ce statut.</p>

        <a href="{{ path('app_statut_tache_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
