{% extends 'base.html.twig' %}

{% block title %}Type de desserte{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Type de desserte</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_type_desserte_edit', {'id': type_desserte.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('type_desserte/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ type_desserte.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ type_desserte.label }}</td>
                </tr>
            </tbody>
        </table>

        <p class="text-muted small">
            {{ type_desserte.tronconDessertes|length }} tronçon(s)-desserte utilisent ce type.
        </p>

        <a href="{{ path('app_type_desserte_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
