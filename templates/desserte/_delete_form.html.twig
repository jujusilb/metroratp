<form method="post" action="{{ path('app_desserte_delete', {'id': desserte.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ desserte.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
