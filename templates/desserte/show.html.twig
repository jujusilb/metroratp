{% extends 'base.html.twig' %}

{% block title %}Desserte{% endblock %}

{% macro oui_non(valeur) %}
    {% if valeur is null %}
        <span class="text-muted">Non renseigné</span>
    {% elseif valeur %}
        <span class="badge text-bg-success">Oui</span>
    {% else %}
        <span class="badge text-bg-secondary">Non</span>
    {% endif %}
{% endmacro %}

{% import _self as macros %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Desserte</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_desserte_edit', {'id': desserte.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('desserte/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ desserte.id }}</td>
                </tr>
                <tr>
                    <th>Station</th>
                    <td>
                        {% if desserte.station %}
                            <a href="{{ path('app_station_show', {'id': desserte.station.id}) }}" class="link-body-emphasis">
                                {{ desserte.station.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Ligne</th>
                    <td>
                        {% if desserte.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': desserte.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ desserte.ligne.couleur|default('#6c757d') }};"></span> {{ desserte.ligne.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Type de transport</th>
                    <td>{{ desserte.ligne and desserte.ligne.typeTransport ? desserte.ligne.typeTransport.label : '—' }}</td>
                </tr>
                <tr>
                    <th>Style de la station</th>
                    <td>
                        {% if desserte.styleStation %}
                            <a href="{{ path('app_style_station_show', {'id': desserte.styleStation.id}) }}" class="link-body-emphasis">
                                {{ desserte.styleStation.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Style d'écriture</th>
                    <td>
                        {% if desserte.styleEcriture %}
                            <a href="{{ path('app_style_ecriture_show', {'id': desserte.styleEcriture.id}) }}" class="link-body-emphasis">
                                {{ desserte.styleEcriture.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Statut</th>
                    <td>
                        {% if desserte.ouverte %}
                            <span class="badge text-bg-success">Ouverte</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Fermée depuis le {{ desserte.dernierePeriode.fermeture|date('Y-m-d') }}</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Accessible (officiel IDFM)</th>
                    <td>{{ macros.oui_non(desserte.estAccessible) }}</td>
                </tr>
                <tr>
                    <th>Signalisation sonore</th>
                    <td>{{ macros.oui_non(desserte.signalisationSonore) }}</td>
                </tr>
                <tr>
                    <th>Signalisation visuelle</th>
                    <td>{{ macros.oui_non(desserte.signalisationVisuelle) }}</td>
                </tr>
                <tr>
                    <th>Climatisation</th>
                    <td>
                        {% if desserte.climatisation %}
                            {{ desserte.climatisation }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Équipement de l'arrêt</th>
                    <td>
                        {% if desserte.equipementArret %}
                            <a href="{{ path('app_equipement_arret_show', {'id': desserte.equipementArret.id}) }}" class="link-body-emphasis">
                                {{ desserte.equipementArret.nom }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Périodes d'ouverture</h2>

        {% if desserte.periodesOuvertureOrdonnees|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Ordre</th>
                        <th>Ouverture</th>
                        <th>Fermeture</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for periode in desserte.periodesOuvertureOrdonnees %}
                    <tr>
                        <td>{{ periode.ordre }}</td>
                        <td>{{ periode.ouverture ? periode.ouverture|date('Y-m-d') : '' }}</td>
                        <td>{{ periode.fermeture ? periode.fermeture|date('Y-m-d') : '' }}</td>
                        <td>
                            <a href="{{ path('app_periode_ouverture_show', {'id': periode.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_periode_ouverture_edit', {'id': periode.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune période d'ouverture enregistrée pour cette desserte.</p>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_periode_ouverture_new', {'desserte': desserte.id}) }}" class="btn btn-outline-primary btn-sm mb-4">Ajouter une période d'ouverture</a>
        {% endif %}

        <h2 class="h5 mt-4 mb-3">Correspondances</h2>

        {% if desserte.correspondances|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Vers</th>
                        <th>Distance</th>
                        <th>Temps estimé</th>
                        <th>En zone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for correspondance in desserte.correspondances %}
                    {% set autre = desserte.getAutreDesserte(correspondance) %}
                    <tr>
                        <td>
                            {% if autre and autre.station %}
                                <a href="{{ path('app_station_show', {'id': autre.station.id}) }}" class="link-body-emphasis">
                                    {{ autre.station.label }}
                                </a>
                                {% if autre.ligne %}
                                    <a href="{{ path('app_ligne_show', {'id': autre.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ autre.ligne.couleur|default('#6c757d') }};"></span> {{ autre.ligne.label }}</a>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ correspondance.distance ? correspondance.distance ~ ' m' : '—' }}</td>
                        <td>{{ correspondance.tempsEstimeMinutes ? correspondance.tempsEstimeMinutes ~ ' min' : '—' }}</td>
                        <td>
                            {% if correspondance.inZone %}
                                <span class="badge text-bg-success">Oui</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Non</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_correspondance_show', {'id': correspondance.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune correspondance enregistrée pour cette desserte.</p>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_correspondance_new') }}" class="btn btn-outline-primary btn-sm mb-4">Ajouter une correspondance</a>
        {% endif %}

        <a href="{{ path('app_desserte_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
