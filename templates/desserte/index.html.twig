{% extends 'base.html.twig' %}

{% block title %}Desserte{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Desserte</h1>

        {{ include('tools/filtre_liste.html.twig', {
            'modesSelectionnes': modesSelectionnes,
            'recherche': recherche,
            'route': 'app_desserte_index',
            'libelleRecherche': 'une station ou une ligne',
            'placeholderRecherche': 'Nom de station ou numéro de ligne...',
            'gestionnaires': gestionnaires,
            'gestionnairesSelectionnes': gestionnairesSelectionnes,
        }) }}

        <p class="text-muted small">{{ dessertes.getTotalItemCount }} desserte{{ dessertes.getTotalItemCount > 1 ? 's' : '' }}</p>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(dessertes, 'Station', 'station.label') }}</th>
                    <th>{{ knp_pagination_sortable(dessertes, 'Ligne', 'ligne.label') }}</th>
                    <th>{{ knp_pagination_sortable(dessertes, 'Type', 'tt.label') }}</th>
                    <th>{{ knp_pagination_sortable(dessertes, 'Style', 'styleStation.label') }}</th>
                    <th>Première ouverture</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for desserte in dessertes %}
                <tr>
                    <td>
                        {% if desserte.station %}
                            <a href="{{ path('app_station_show', {'id': desserte.station.id}) }}" class="link-body-emphasis">
                                {{ desserte.station.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if desserte.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': desserte.ligne.id}) }}" class="ligne-badge-sm" style="background-color: {{ desserte.ligne.couleur|default('#6c757d') }};">
                                {{ desserte.ligne.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ desserte.ligne and desserte.ligne.typeTransport ? desserte.ligne.typeTransport.label : '—' }}</td>
                    <td>
                        {% if desserte.styleStation %}
                            <a href="{{ path('app_style_station_show', {'id': desserte.styleStation.id}) }}" class="link-body-emphasis">
                                {{ desserte.styleStation.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ desserte.premiereOuverture ? desserte.premiereOuverture|date('Y-m-d') : '' }}</td>
                    <td>
                        {% if desserte.ouverte %}
                            <span class="badge text-bg-success">Ouverte</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Fermée le {{ desserte.dernierePeriode.fermeture|date('Y-m-d') }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_desserte_show', {'id': desserte.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_desserte_edit', {'id': desserte.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="d-flex justify-content-center mb-3">
            {{ knp_pagination_render(dessertes) }}
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_desserte_new') }}" class="btn btn-primary">Créer nouvelle desserte</a>
        {% endif %}
    </div>
{% endblock %}
