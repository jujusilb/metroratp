{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.username) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.email) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.prenom) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.nom) }}
        </div>
    </div>

    {{ form_row(form.telephone) }}

    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.adresseLigne1) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.adresseLigne2) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            {{ form_row(form.codePostal) }}
        </div>
        <div class="col-md-8">
            {{ form_row(form.ville) }}
        </div>
    </div>

    <hr class="my-3">

    {{ form_row(form.plainPassword) }}

    <button type="submit" class="btn btn-primary mt-2">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
