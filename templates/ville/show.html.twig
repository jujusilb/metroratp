{% extends 'base.html.twig' %}

{% block title %}Ville {{ ville.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">{{ ville.label }}</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Code INSEE</th>
                    <td>{{ ville.codeInsee }}</td>
                </tr>
                <tr>
                    <th>Codes postaux</th>
                    <td>{{ ville.codesPostaux ? ville.codesPostaux|join(', ') : '—' }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Stations ({{ ville.stations|length }})</h2>
        {% if ville.stations|length > 0 %}
            <ul class="list-group mb-4">
                {% for station in ville.stations %}
                    <li class="list-group-item">
                        <a href="{{ path('app_station_show', {'id': station.id}) }}" class="link-body-emphasis">{{ station.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune station rattachée à cette ville.</p>
        {% endif %}

        <h2 class="h5 mt-4 mb-3">Lignes concernées</h2>

        <h3 class="h6 mt-3">Entièrement dans la ville ({{ lignesConcernees.completementDedans|length }})</h3>
        {% if lignesConcernees.completementDedans|length > 0 %}
            <ul class="list-group mb-3">
                {% for ligne in lignesConcernees.completementDedans %}
                    <li class="list-group-item">
                        {% if ligne.couleur %}<span class="pastille-ligne" style="--ligne-couleur: {{ ligne.couleur }};"></span>{% endif %}
                        <a href="{{ path('app_ligne_show', {'id': ligne.id}) }}" class="link-body-emphasis">{{ ligne.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune.</p>
        {% endif %}

        <h3 class="h6 mt-3">Un bout hors de la ville ({{ lignesConcernees.unBoutDehors|length }})</h3>
        {% if lignesConcernees.unBoutDehors|length > 0 %}
            <ul class="list-group mb-3">
                {% for ligne in lignesConcernees.unBoutDehors %}
                    <li class="list-group-item">
                        {% if ligne.couleur %}<span class="pastille-ligne" style="--ligne-couleur: {{ ligne.couleur }};"></span>{% endif %}
                        <a href="{{ path('app_ligne_show', {'id': ligne.id}) }}" class="link-body-emphasis">{{ ligne.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune.</p>
        {% endif %}

        <h3 class="h6 mt-3">Traversée simple ({{ lignesConcernees.traversee|length }})</h3>
        {% if lignesConcernees.traversee|length > 0 %}
            <ul class="list-group mb-3">
                {% for ligne in lignesConcernees.traversee %}
                    <li class="list-group-item">
                        {% if ligne.couleur %}<span class="pastille-ligne" style="--ligne-couleur: {{ ligne.couleur }};"></span>{% endif %}
                        <a href="{{ path('app_ligne_show', {'id': ligne.id}) }}" class="link-body-emphasis">{{ ligne.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune.</p>
        {% endif %}

        <a href="{{ path('app_ville_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
    </div>
{% endblock %}
