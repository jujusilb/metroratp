{% extends 'base.html.twig' %}

{% block title %}Missions — Ligne {{ ligne.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="ligne-badge rounded-circle d-inline-flex align-items-center justify-content-center" style="background-color: {{ ligne.couleur|default('#6c757d') }};">{{ ligne.label }}</span>
            <h1 class="mb-0">Choisir une direction</h1>
        </div>

        <div class="d-flex flex-wrap gap-3">
            {% for direction in directions %}
                <a href="{{ path('app_mission_choix_service', {'ligneId': ligne.id, 'directionId': direction.id}) }}"
                   class="btn btn-lg btn-outline-primary rounded-pill px-4">
                    Direction {{ direction.station.label }}
                </a>
            {% else %}
                <p class="text-muted">Aucune mission pour cette ligne.</p>
            {% endfor %}
        </div>

        <a href="{{ path('app_mission_index') }}" class="btn btn-secondary mt-4">Retour aux lignes</a>
    </div>
{% endblock %}
