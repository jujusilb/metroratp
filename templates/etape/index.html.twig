{% extends 'base.html.twig' %}

{% block title %}Étapes{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Étapes</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(etapes, 'Nom', 'e.nom') }}</th>
                    <th>{{ knp_pagination_sortable(etapes, 'Tâche', 'tache.nom') }}</th>
                    <th>{{ knp_pagination_sortable(etapes, 'Créée le', 'e.datetimeCreation') }}</th>
                    <th>{{ knp_pagination_sortable(etapes, 'Achevée le', 'e.datetimeAchevement') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for etape in etapes %}
                <tr>
                    <td>{{ etape.nom }}</td>
                    <td>
                        {% if etape.tache %}
                            <a href="{{ path('app_tache_show', {'id': etape.tache.id}) }}">{{ etape.tache.nom }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ etape.datetimeCreation ? etape.datetimeCreation|date('d/m/Y') : '—' }}</td>
                    <td>
                        {% if etape.datetimeAchevement %}
                            <span class="badge text-bg-success">{{ etape.datetimeAchevement|date('d/m/Y') }}</span>
                        {% else %}
                            <span class="badge text-bg-secondary">En cours</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_etape_show', {'id': etape.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        <a href="{{ path('app_etape_edit', {'id': etape.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(etapes) }}

        <a href="{{ path('app_etape_new') }}" class="btn btn-primary">Créer nouvelle étape</a>
    </div>
{% endblock %}
