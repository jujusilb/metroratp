{% extends 'base.html.twig' %}

{% block title %}Étape {{ etape.nom }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ etape.nom }}</h1>
            <div class="d-flex gap-2">
                <a href="{{ path('app_etape_edit', {'id': etape.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                {{ include('etape/_delete_form.html.twig') }}
            </div>
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Tâche</th>
                    <td>
                        {% if etape.tache %}
                            <a href="{{ path('app_tache_show', {'id': etape.tache.id}) }}">{{ etape.tache.nom }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td style="white-space: pre-line;">{{ etape.description ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Créée le</th>
                    <td>{{ etape.datetimeCreation ? etape.datetimeCreation|date('d/m/Y H:i') : '—' }}</td>
                </tr>
                <tr>
                    <th>Achevée le</th>
                    <td>{{ etape.datetimeAchevement ? etape.datetimeAchevement|date('d/m/Y H:i') : '—' }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_etape_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
