{% extends 'base.html.twig' %}

{% block title %}StyleAcces{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Style d'accès</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_style_acces_edit', {'id': style_acces.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('style_acces/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ style_acces.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ style_acces.label }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Accès de ce style</h2>

        {% if style_acces.acces|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Station</th>
                        <th>Accès</th>
                        <th>Numéro</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for acces in style_acces.acces %}
                    <tr>
                        <td>
                            {% set sortie = acces.sorties.first %}
                            {% if sortie and sortie.station %}
                                <a href="{{ path('app_station_show', {'id': sortie.station.id}) }}" class="link-body-emphasis">
                                    {{ sortie.station.label }}
                                </a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ acces.label }}</td>
                        <td>{{ acces.numero ?? '—' }}</td>
                        <td>
                            <a href="{{ path('app_acces_show', {'id': acces.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucun accès enregistré pour ce style.</p>
        {% endif %}

        <a href="{{ path('app_style_acces_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
