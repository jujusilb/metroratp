{% extends 'base.html.twig' %}

{% block title %}Style d'accès{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Style d'accès</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(style_acces_list, 'Label', 's.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for style_acces in style_acces_list %}
                <tr>
                    <td>{{ style_acces.label }}</td>
                    <td>
                        <a href="{{ path('app_style_acces_show', {'id': style_acces.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_style_acces_edit', {'id': style_acces.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(style_acces_list) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_style_acces_new') }}" class="btn btn-primary">Créer nouveau style d'accès</a>
        {% endif %}
    </div>
{% endblock %}
