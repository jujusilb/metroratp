{% extends 'base.html.twig' %}

{% block title %}Tronçon{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Tronçon</h1>

        {{ include('tools/filtre_liste.html.twig', {
            'modesSelectionnes': modesSelectionnes,
            'recherche': recherche,
            'route': 'app_troncon_index',
            'libelleRecherche': 'une station ou une ligne',
            'placeholderRecherche': 'Nom de station ou numéro de ligne...',
            'gestionnaires': gestionnaires,
            'gestionnairesSelectionnes': gestionnairesSelectionnes,
        }) }}

        <p class="text-muted small">{{ troncons.getTotalItemCount }} tronçon{{ troncons.getTotalItemCount > 1 ? 's' : '' }}</p>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(troncons, 'Distance', 't.distance') }}</th>
                    <th>Départ</th>
                    <th>Arrivée</th>
                    <th>Direction</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for troncon in troncons %}
                {% set sens = troncon.sensCirculation %}
                {% if sens|length > 0 %}
                    {% for s in sens %}
                        <tr>
                            {% if loop.first %}
                                <td rowspan="{{ sens|length }}">{{ troncon.distance ? troncon.distance|round ~ ' m' : '—' }}</td>
                            {% endif %}
                            <td>
                                {% if s.depart and s.depart.station %}
                                    <a href="{{ path('app_station_show', {'id': s.depart.station.id}) }}" class="link-body-emphasis">{{ s.depart.station.label }}</a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if s.arrivee and s.arrivee.station %}
                                    <a href="{{ path('app_station_show', {'id': s.arrivee.station.id}) }}" class="link-body-emphasis">{{ s.arrivee.station.label }}</a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if s.direction and s.direction.station %}
                                    <span class="text-muted">{{ s.direction.station.label }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            {% if loop.first %}
                                <td rowspan="{{ sens|length }}">
                                    <a href="{{ path('app_troncon_show', {'id': troncon.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('app_troncon_edit', {'id': troncon.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>{{ troncon.distance ? troncon.distance|round ~ ' m' : '—' }}</td>
                        <td colspan="3" class="text-muted">Aucun sens de circulation enregistré</td>
                        <td>
                            <a href="{{ path('app_troncon_show', {'id': troncon.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_troncon_edit', {'id': troncon.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
            {% else %}
                <tr>
                    <td colspan="5">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="d-flex justify-content-center mb-3">
            {{ knp_pagination_render(troncons) }}
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_troncon_new') }}" class="btn btn-primary">Créer nouveau tronçon</a>
        {% endif %}
    </div>
{% endblock %}
