{% extends 'base.html.twig' %}

{% block title %}Troncon{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Tronçon</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_troncon_edit', {'id': troncon.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('troncon/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ troncon.id }}</td>
                </tr>
                <tr>
                    <th>Distance</th>
                    <td>{{ troncon.distance ? troncon.distance|round ~ ' m' : '—' }}</td>
                </tr>
                <tr>
                    <th>Type de tronçon</th>
                    <td>
                        {% if troncon.typeTroncon %}
                            <a href="{{ path('app_type_troncon_show', {'id': troncon.typeTroncon.id}) }}" class="link-body-emphasis">
                                {{ troncon.typeTroncon.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Sens de circulation</h2>

        {% set sens = troncon.sensCirculation %}
        {% if sens|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Départ</th>
                        <th>Arrivée</th>
                        <th>Direction</th>
                    </tr>
                </thead>
                <tbody>
                {% for s in sens %}
                    <tr>
                        <td>
                            {% if s.depart and s.depart.station %}
                                <a href="{{ path('app_station_show', {'id': s.depart.station.id}) }}" class="link-body-emphasis">{{ s.depart.station.label }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if s.arrivee and s.arrivee.station %}
                                <a href="{{ path('app_station_show', {'id': s.arrivee.station.id}) }}" class="link-body-emphasis">{{ s.arrivee.station.label }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if s.direction and s.direction.station %}
                                {{ s.direction.station.label }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucun sens de circulation enregistré pour ce tronçon.</p>
        {% endif %}

        <h2 class="h5 mt-4 mb-3">Dessertes de ce tronçon (détail)</h2>

        {% if troncon.tronconDessertes|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Desserte</th>
                        <th>Type</th>
                        <th>Durée réelle</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for td in troncon.tronconDessertes %}
                    <tr>
                        <td>
                            {% if td.desserte and td.desserte.station %}
                                <a href="{{ path('app_station_show', {'id': td.desserte.station.id}) }}" class="link-body-emphasis">{{ td.desserte.station.label }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ td.typeDesserte ? td.typeDesserte.label : '—' }}</td>
                        <td>{{ td.dureeReelleSecondes ? td.dureeReelleSecondes ~ ' s' : '—' }}</td>
                        <td>
                            <a href="{{ path('app_troncon_desserte_show', {'id': td.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_troncon_desserte_edit', {'id': td.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune desserte enregistrée pour ce tronçon.</p>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_troncon_desserte_new', {'troncon': troncon.id}) }}" class="btn btn-outline-primary btn-sm mb-4">Ajouter une desserte</a>
        {% endif %}

        <div>
            <a href="{{ path('app_troncon_index') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </div>
{% endblock %}
