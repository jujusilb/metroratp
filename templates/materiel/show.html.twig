{% extends 'base.html.twig' %}

{% block title %}Materiel{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Matériel</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_materiel_edit', {'id': materiel.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('materiel/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ materiel.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ materiel.label }}</td>
                </tr>
                <tr>
                    <th>Année de production</th>
                    <td>{{ materiel.anneeProduction ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Constructeur</th>
                    <td>{{ materiel.constructeur ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Vitesse maximale</th>
                    <td>{{ materiel.vitesseMaxKmh ? materiel.vitesseMaxKmh ~ ' km/h' : '—' }}</td>
                </tr>
                <tr>
                    <th>Type de matériel</th>
                    <td>
                        {% if materiel.typeMateriel %}
                            <a href="{{ path('app_type_materiel_show', {'id': materiel.typeMateriel.id}) }}" class="link-body-emphasis">
                                {{ materiel.typeMateriel.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Lignes desservies</h2>

        {% if materiel.materielLignes|length > 0 %}
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Ligne</th>
                        <th>Arrivée</th>
                        <th>Fin</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for materiel_ligne in materiel.materielLignes %}
                    <tr>
                        <td>
                            {% if materiel_ligne.ligne %}
                                <a href="{{ path('app_ligne_show', {'id': materiel_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ materiel_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ materiel_ligne.ligne.label }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ materiel_ligne.arrivee ? materiel_ligne.arrivee|date('Y-m-d') : '' }}</td>
                        <td>{{ materiel_ligne.fin ? materiel_ligne.fin|date('Y-m-d') : '' }}</td>
                        <td>
                            <a href="{{ path('app_materiel_ligne_show', {'id': materiel_ligne.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune ligne desservie enregistrée pour ce matériel.</p>
        {% endif %}

        <h2 class="h5 mt-4 mb-3">Dépôts</h2>

        {% if materiel.materielDepots|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Dépôt</th>
                        <th>Arrivée</th>
                        <th>Fin</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for materiel_depot in materiel.materielDepots %}
                    <tr>
                        <td>
                            {% if materiel_depot.depot %}
                                <a href="{{ path('app_depot_show', {'id': materiel_depot.depot.id}) }}" class="link-body-emphasis">{{ materiel_depot.depot.label }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ materiel_depot.arrivee ? materiel_depot.arrivee|date('Y-m-d') : '' }}</td>
                        <td>{{ materiel_depot.fin ? materiel_depot.fin|date('Y-m-d') : '' }}</td>
                        <td>
                            <a href="{{ path('app_materiel_depot_show', {'id': materiel_depot.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucun dépôt enregistré pour ce matériel.</p>
        {% endif %}

        <a href="{{ path('app_materiel_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
