{% extends 'base.html.twig' %}

{% block title %}Calculer un trajet{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Calculer un trajet</h1>

        <p class="text-muted small">
            Plus court chemin calculé avec l'algorithme de Dijkstra, sur le réseau des tronçons et des correspondances.
            Les temps de tronçon sont calculés à partir des horaires théoriques du GTFS Île-de-France Mobilités
            (369 tronçons sur 376 ; les autres utilisent une estimation de 2 min faute de correspondance trouvée).
            Les temps de correspondance restent des <strong>estimations</strong> (temps de marche connu sinon 3 min
            par défaut, plus 2 min d'attente moyenne du prochain train) — ce ne sont pas des données officielles RATP.
            La carte utilise les coordonnées du plan schématique officiel Île-de-France Mobilités
            (300 stations sur 315 positionnées ; les extensions les plus récentes n'y figurent pas encore).
        </p>

        {% set modeLabels = {'metro': 'Métro', 'tram': 'Tram', 'rer': 'RER', 'bus_ratp': 'Bus RATP', 'bus_tiers': 'Bus tiers'} %}
        <form method="get" class="row g-3 mb-4"
              data-recherche-station-url="{{ path('app_trajet_recherche_station') }}"
              data-mode-labels="{{ modeLabels|json_encode }}">
            <div class="col-12">
                <span class="form-label d-block">Modes de transport</span>
                <div class="d-flex flex-wrap gap-3">
                    {% for mode, label in modeLabels %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="modes[]" value="{{ mode }}" id="mode-{{ mode }}" {{ mode in modesSelectionnes ? 'checked' : '' }}>
                            <label class="form-check-label" for="mode-{{ mode }}">{{ label }}</label>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="col-md-5 position-relative">
                <label for="origine-recherche" class="form-label">Départ</label>
                <input type="text" id="origine-recherche" class="form-control" autocomplete="off"
                       placeholder="-- Rechercher une station --"
                       value="{{ stationOrigine ? stationOrigine.label ~ (stationOrigine.ville ? ' (' ~ stationOrigine.ville ~ ')' : '') ~ (origineMode ? ' — ' ~ modeLabels[origineMode] : '') : '' }}">
                <input type="hidden" name="origine" id="origine" value="{{ stationOrigine ? stationOrigine.id : '' }}">
                <input type="hidden" name="origineMode" id="origine-mode" value="{{ origineMode ?? '' }}">
                <div id="origine-suggestions" class="list-group position-absolute w-100" style="z-index: 1000;"></div>
            </div>
            <div class="col-md-5 position-relative">
                <label for="destination-recherche" class="form-label">Arrivée</label>
                <input type="text" id="destination-recherche" class="form-control" autocomplete="off"
                       placeholder="-- Rechercher une station --"
                       value="{{ stationDestination ? stationDestination.label ~ (stationDestination.ville ? ' (' ~ stationDestination.ville ~ ')' : '') ~ (destinationMode ? ' — ' ~ modeLabels[destinationMode] : '') : '' }}">
                <input type="hidden" name="destination" id="destination" value="{{ stationDestination ? stationDestination.id : '' }}">
                <input type="hidden" name="destinationMode" id="destination-mode" value="{{ destinationMode ?? '' }}">
                <div id="destination-suggestions" class="list-group position-absolute w-100" style="z-index: 1000;"></div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Calculer</button>
            </div>
        </form>

        {% if erreur %}
            <div class="alert alert-warning">{{ erreur }}</div>
        {% endif %}
    </div>

    {% if resultat %}
        <div class="container-fluid px-4">
            <div class="d-flex gap-3 mb-3">
                <span class="badge text-bg-primary fs-6">{{ resultat.dureeMinutesTotale|round(1) }} min</span>
                <span class="badge text-bg-secondary fs-6">{{ resultat.nombreCorrespondances }} correspondance{{ resultat.nombreCorrespondances > 1 ? 's' : '' }}</span>
                <span class="badge text-bg-light text-dark fs-6">{{ resultat.etapes|length }} étapes</span>
            </div>

            {% if carteJson %}
                <p class="small text-muted mb-1">Molette pour zoomer, cliquer-glisser pour se déplacer</p>
                <div id="trajet-carte" data-carte="{{ carteJson }}" style="border: 1px solid #dee2e6; border-radius: 6px;" class="mb-2">
                    <svg id="trajet-carte-svg" viewBox="0 0 900 620" style="width: 100%; height: 500px; display: block; cursor: grab; touch-action: none;"></svg>
                </div>
                <div id="trajet-carte-legende" class="row row-cols-1 row-cols-md-3 g-1 mb-4 small"></div>
            {% endif %}

            {% if segments|length > 0 %}
                <ul class="nav nav-pills mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="onglet-simple" data-bs-toggle="pill" data-bs-target="#vue-simple" type="button" role="tab" aria-controls="vue-simple" aria-selected="true">Simple</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="onglet-detaille" data-bs-toggle="pill" data-bs-target="#vue-detaillee" type="button" role="tab" aria-controls="vue-detaillee" aria-selected="false">Détaillé</button>
                    </li>
                </ul>

                <div class="tab-content mb-4">
                    <div class="tab-pane fade show active" id="vue-simple" role="tabpanel" aria-labelledby="onglet-simple">
                        <p class="mb-2">
                            {% for ligne in resumeSimple.lignes %}
                                <span class="ligne-badge-sm" style="background-color: {{ ligne.couleur }};"><span class="visually-hidden">Ligne </span>{{ ligne.label }}</span>{% if not loop.last %} <span aria-hidden="true">→</span> {% endif %}
                            {% endfor %}
                        </p>
                        <p class="mb-3">
                            {% for station in resumeSimple.stations %}
                                <a href="{{ path('app_station_show', {'id': station.id}) }}" class="link-body-emphasis">{{ station.label }}</a>{% if not loop.last %} <span aria-hidden="true">→</span> {% endif %}
                            {% endfor %}
                        </p>
                        <ul class="list-group">
                            {% for segment in resumeSimple.segments %}
                                <li class="list-group-item d-flex align-items-center gap-2">
                                    <span class="ligne-badge-sm" style="background-color: {{ segment.couleur }};"><span class="visually-hidden">Ligne </span>{{ segment.ligne }}</span>
                                    <a href="{{ path('app_station_show', {'id': segment.depart.id}) }}" class="link-body-emphasis">{{ segment.depart.label }}</a>
                                    <span aria-hidden="true">→</span>
                                    <a href="{{ path('app_station_show', {'id': segment.arrivee.id}) }}" class="link-body-emphasis">{{ segment.arrivee.label }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="tab-pane fade" id="vue-detaillee" role="tabpanel" aria-labelledby="onglet-detaille">
                        <ul class="list-group">
                            {% for segment in segments %}
                                {% if segment.type == 'correspondance' %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center border-start border-danger border-3">
                                        <span>
                                            <span class="badge text-bg-danger me-2">
                                                Correspondance
                                                <span class="visually-hidden">de la ligne {{ segment.depart.ligne.label }} à la ligne {{ segment.arrivee.ligne.label }}</span>
                                            </span>
                                            <a href="{{ path('app_station_show', {'id': segment.depart.station.id}) }}" class="link-body-emphasis">{{ segment.depart.station.label }}</a>
                                            <span class="ligne-badge-sm" style="background-color: {{ segment.depart.ligne.couleur|default('#6c757d') }};" aria-hidden="true">{{ segment.depart.ligne.label }}</span>
                                            <span aria-hidden="true">→</span>
                                            <span class="ligne-badge-sm" style="background-color: {{ segment.arrivee.ligne.couleur|default('#6c757d') }};" aria-hidden="true">{{ segment.arrivee.ligne.label }}</span>
                                        </span>
                                        <span class="text-muted">{{ segment.duree|round(1) }} min</span>
                                    </li>
                                {% else %}
                                    <li class="list-group-item d-flex justify-content-between align-items-start">
                                        <span>
                                            <span class="ligne-badge-sm me-2" style="background-color: {{ segment.dessertes|first.ligne.couleur|default('#6c757d') }};">
                                                <span class="visually-hidden">Ligne </span>{{ segment.dessertes|first.ligne.label }}
                                            </span>
                                            {% for desserte in segment.dessertes %}
                                                <a href="{{ path('app_station_show', {'id': desserte.station.id}) }}" class="link-body-emphasis">{{ desserte.station.label }}</a>{% if not loop.last %} <span aria-hidden="true">→</span> {% endif %}
                                            {% endfor %}
                                        </span>
                                        <span class="text-muted text-nowrap ms-2">{{ segment.duree|round(1) }} min</span>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% else %}
                <p class="text-muted mb-4">Départ et arrivée identiques.</p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
