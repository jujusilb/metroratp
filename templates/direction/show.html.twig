{% extends 'base.html.twig' %}

{% block title %}Direction{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Direction</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_direction_edit', {'id': direction.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('direction/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ direction.id }}</td>
                </tr>
                <tr>
                    <th>Ligne</th>
                    <td>
                        <a href="{{ path('app_ligne_show', {'id': direction.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ direction.ligne.couleur|default('#6c757d') }};"></span> {{ direction.ligne.label }}</a>
                    </td>
                </tr>
                <tr>
                    <th>Terminus</th>
                    <td>
                        {% if direction.station %}
                            <a href="{{ path('app_station_show', {'id': direction.station.id}) }}" class="link-body-emphasis">{{ direction.station.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_ligne_show', {'id': direction.ligne.id}) }}" class="btn btn-secondary">Retour à la ligne</a>
    </div>
{% endblock %}
