{% extends 'base.html.twig' %}

{% block title %}Tâche {{ tache.nom }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">{{ tache.nom }}</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Statut</th>
                    <td>{{ tache.statut.label ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td style="white-space: pre-line;">{{ tache.description ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Créée le</th>
                    <td>{{ tache.datetimeCreation ? tache.datetimeCreation|date('d/m/Y H:i') : '—' }}</td>
                </tr>
                <tr>
                    <th>Dernière action le</th>
                    <td>{{ tache.datetimeAction ? tache.datetimeAction|date('d/m/Y H:i') : '—' }}</td>
                </tr>
                <tr>
                    <th>Achevée le</th>
                    <td>{{ tache.datetimeAchevement ? tache.datetimeAchevement|date('d/m/Y H:i') : '—' }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Étapes</h2>

        {% if tache.etapes|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Créée le</th>
                        <th>Achevée le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for etape in tache.etapes %}
                    <tr>
                        <td>{{ etape.nom }}</td>
                        <td>{{ etape.description ?? '—' }}</td>
                        <td>{{ etape.datetimeCreation ? etape.datetimeCreation|date('d/m/Y') : '—' }}</td>
                        <td>
                            {% if etape.datetimeAchevement %}
                                <span class="badge text-bg-success">{{ etape.datetimeAchevement|date('d/m/Y') }}</span>
                            {% else %}
                                <span class="badge text-bg-secondary">En cours</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_etape_show', {'id': etape.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune étape enregistrée.</p>
        {% endif %}
        <a href="{{ path('app_etape_new') }}" class="btn btn-primary btn-sm mb-4">Ajouter une étape</a>

        <div class="d-flex gap-2">
            <a href="{{ path('app_tache_index') }}" class="btn btn-secondary">Retour à la liste</a>
            <a href="{{ path('app_tache_edit', {'id': tache.id}) }}" class="btn btn-warning">Modifier</a>
        </div>

        {{ include('tache/_delete_form.html.twig') }}
    </div>
{% endblock %}
