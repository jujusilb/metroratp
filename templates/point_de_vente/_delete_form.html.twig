{% if is_granted('ROLE_ADMIN') %}
<form method="post" action="{{ path('app_point_de_vente_delete', {'id': point_de_vente.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ point_de_vente.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
{% endif %}
