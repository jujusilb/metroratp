{% extends 'base.html.twig' %}

{% block title %}Point de vente {{ point_de_vente.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ point_de_vente.label }}</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_point_de_vente_edit', {'id': point_de_vente.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('point_de_vente/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Type</th>
                    <td>{{ point_de_vente.type ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Adresse</th>
                    <td>{{ point_de_vente.adresse ?? '—' }} {{ point_de_vente.codePostal }} {{ point_de_vente.ville }}</td>
                </tr>
                <tr>
                    <th>Horaires</th>
                    <td>{{ point_de_vente.horaires ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Catégorie du commerce</th>
                    <td>{{ point_de_vente.categorieCommerce ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Jour de fermeture</th>
                    <td>{{ point_de_vente.jourFermeture ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Station la plus proche</th>
                    <td>
                        {% if point_de_vente.station %}
                            <a href="{{ path('app_station_show', {'id': point_de_vente.station.id}) }}">{{ point_de_vente.station.label }}</a>
                        {% else %}
                            <span class="text-muted">Aucune à proximité</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_point_de_vente_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
