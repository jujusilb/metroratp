{% extends 'base.html.twig' %}

{% block title %}Point d'intérêt{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">{{ point_interet.label }}</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_point_interet_edit', {'id': point_interet.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('point_interet/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <h2 class="h5 mt-4 mb-3">Stations à proximité</h2>

        {% if point_interet.stations|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Station</th>
                        <th>Ville</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for station in point_interet.stations %}
                    <tr>
                        <td>
                            <a href="{{ path('app_station_show', {'id': station.id}) }}" class="link-body-emphasis">
                                {{ station.label }}
                            </a>
                        </td>
                        <td>{{ station.ville ?? '—' }}</td>
                        <td>
                            <a href="{{ path('app_station_show', {'id': station.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucune station rattachée à ce lieu.</p>
        {% endif %}

        <a href="{{ path('app_point_interet_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
