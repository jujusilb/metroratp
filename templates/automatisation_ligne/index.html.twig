{% extends 'base.html.twig' %}

{% block title %}Automatisation-Ligne{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Automatisation-Ligne</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(automatisation_lignes, 'Ligne', 'ligne.label') }}</th>
                    <th>{{ knp_pagination_sortable(automatisation_lignes, 'Automatisation', 'automatisation.label') }}</th>
                    <th>{{ knp_pagination_sortable(automatisation_lignes, 'Date de mise en place', 'al.dateDeMiseEnPlace') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for automatisation_ligne in automatisation_lignes %}
                <tr>
                    <td>
                        {% if automatisation_ligne.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': automatisation_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ automatisation_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ automatisation_ligne.ligne.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if automatisation_ligne.automatisation %}
                            <a href="{{ path('app_automatisation_show', {'id': automatisation_ligne.automatisation.id}) }}" class="link-body-emphasis">
                                {{ automatisation_ligne.automatisation.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ automatisation_ligne.dateDeMiseEnPlace ? automatisation_ligne.dateDeMiseEnPlace|date('Y-m-d') : '' }}</td>
                    <td>
                        <a href="{{ path('app_automatisation_ligne_show', {'id': automatisation_ligne.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_automatisation_ligne_edit', {'id': automatisation_ligne.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(automatisation_lignes) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_automatisation_ligne_new') }}" class="btn btn-primary">Créer nouvelle automatisation-ligne</a>
        {% endif %}
    </div>
{% endblock %}
