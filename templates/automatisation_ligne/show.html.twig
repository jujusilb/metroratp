{% extends 'base.html.twig' %}

{% block title %}AutomatisationLigne{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Automatisation-Ligne</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ automatisation_ligne.id }}</td>
                </tr>
                <tr>
                    <th>Ligne</th>
                    <td>
                        {% if automatisation_ligne.ligne %}
                            <a href="{{ path('app_ligne_show', {'id': automatisation_ligne.ligne.id}) }}" class="link-body-emphasis text-decoration-none"><span class="pastille-ligne" style="--ligne-couleur: {{ automatisation_ligne.ligne.couleur|default('#6c757d') }};"></span> {{ automatisation_ligne.ligne.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Automatisation</th>
                    <td>
                        {% if automatisation_ligne.automatisation %}
                            <a href="{{ path('app_automatisation_show', {'id': automatisation_ligne.automatisation.id}) }}" class="link-body-emphasis">
                                {{ automatisation_ligne.automatisation.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Date de mise en place</th>
                    <td>{{ automatisation_ligne.dateDeMiseEnPlace ? automatisation_ligne.dateDeMiseEnPlace|date('Y-m-d') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <div class="d-flex gap-2">
            <a href="{{ path('app_automatisation_ligne_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_automatisation_ligne_edit', {'id': automatisation_ligne.id}) }}" class="btn btn-warning">Modifier</a>
            {% endif %}
        </div>

        {{ include('automatisation_ligne/_delete_form.html.twig') }}
    </div>
{% endblock %}
