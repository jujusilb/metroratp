{% extends 'base.html.twig' %}

{% block title %}MaterielDepot{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Matériel-Dépôt</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_materiel_depot_edit', {'id': materiel_depot.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('materiel_depot/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ materiel_depot.id }}</td>
                </tr>
                <tr>
                    <th>Matériel</th>
                    <td>
                        {% if materiel_depot.materiel %}
                            <a href="{{ path('app_materiel_show', {'id': materiel_depot.materiel.id}) }}" class="link-body-emphasis">
                                {{ materiel_depot.materiel.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Dépôt</th>
                    <td>
                        {% if materiel_depot.depot %}
                            <a href="{{ path('app_depot_show', {'id': materiel_depot.depot.id}) }}" class="link-body-emphasis">
                                {{ materiel_depot.depot.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Arrivée</th>
                    <td>{{ materiel_depot.arrivee ? materiel_depot.arrivee|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Fin</th>
                    <td>{{ materiel_depot.fin ? materiel_depot.fin|date('Y-m-d') : '' }}</td>
                </tr>
                <tr>
                    <th>Effectif</th>
                    <td>{{ materiel_depot.effectif ?? '' }}</td>
                </tr>
                <tr>
                    <th>Effectif (date du relevé)</th>
                    <td>{{ materiel_depot.effectifDate ? materiel_depot.effectifDate|date('Y-m-d') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_materiel_depot_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
