{% extends 'base.html.twig' %}

{% block title %}Matériel-Dépôt{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Matériel-Dépôt</h1>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(materiel_depots, 'Matériel', 'materiel.label') }}</th>
                    <th>{{ knp_pagination_sortable(materiel_depots, 'Dépôt', 'depot.label') }}</th>
                    <th>{{ knp_pagination_sortable(materiel_depots, 'Arrivée', 'md.arrivee') }}</th>
                    <th>{{ knp_pagination_sortable(materiel_depots, 'Fin', 'md.fin') }}</th>
                    <th>Effectif</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for materiel_depot in materiel_depots %}
                <tr>
                    <td>
                        {% if materiel_depot.materiel %}
                            <a href="{{ path('app_materiel_show', {'id': materiel_depot.materiel.id}) }}" class="link-body-emphasis">
                                {{ materiel_depot.materiel.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if materiel_depot.depot %}
                            <a href="{{ path('app_depot_show', {'id': materiel_depot.depot.id}) }}" class="link-body-emphasis">
                                {{ materiel_depot.depot.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ materiel_depot.arrivee ? materiel_depot.arrivee|date('Y-m-d') : '' }}</td>
                    <td>{{ materiel_depot.fin ? materiel_depot.fin|date('Y-m-d') : '' }}</td>
                    <td>
                        {% if materiel_depot.effectif %}
                            {{ materiel_depot.effectif }}{{ materiel_depot.effectifDate ? ' (au ' ~ materiel_depot.effectifDate|date('d/m/Y') ~ ')' : '' }}
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_materiel_depot_show', {'id': materiel_depot.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_materiel_depot_edit', {'id': materiel_depot.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(materiel_depots) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_materiel_depot_new') }}" class="btn btn-primary">Créer nouveau matériel-dépôt</a>
        {% endif %}
    </div>
{% endblock %}
