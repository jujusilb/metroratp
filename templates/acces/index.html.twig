{% extends 'base.html.twig' %}

{% block title %}Accès{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Accès</h1>

        <form method="get" action="{{ path('app_acces_index') }}" class="row g-3 mb-4 align-items-end">
            <div class="col-12 col-md-6">
                <label for="filtre-recherche" class="form-label">Rechercher</label>
                <input type="text" name="q" id="filtre-recherche" class="form-control" value="{{ recherche }}" placeholder="Nom d'accès, numéro ou nom de station...">
            </div>
            <div class="col-12 col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrer</button>
                {% if recherche %}
                    <a href="{{ path('app_acces_index') }}" class="btn btn-outline-secondary">Réinitialiser</a>
                {% endif %}
            </div>
        </form>

        <p class="text-muted small">{{ acces.getTotalItemCount }} accès</p>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(acces, 'Label', 'a.label') }}</th>
                    <th>{{ knp_pagination_sortable(acces, 'Numéro', 'a.numero') }}</th>
                    <th>{{ knp_pagination_sortable(acces, 'Accessible PMR', 'a.isAccessible') }}</th>
                    <th>{{ knp_pagination_sortable(acces, 'Entrée', 'a.estEntree') }}</th>
                    <th>{{ knp_pagination_sortable(acces, 'Sortie', 'a.estSortie') }}</th>
                    <th>{{ knp_pagination_sortable(acces, 'Style', 'styleAcces.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for acce in acces %}
                <tr>
                    <td>{{ acce.label }}</td>
                    <td>{{ acce.numero }}</td>
                    <td>
                        {% if acce.isAccessible %}
                            <span class="badge text-bg-success">Oui</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Non</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if acce.estEntree == true %}
                            <span class="badge text-bg-success">Oui</span>
                        {% elseif acce.estEntree == false %}
                            <span class="badge text-bg-secondary">Non</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if acce.estSortie == true %}
                            <span class="badge text-bg-success">Oui</span>
                        {% elseif acce.estSortie == false %}
                            <span class="badge text-bg-secondary">Non</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if acce.styleAcces %}
                            <a href="{{ path('app_style_acces_show', {'id': acce.styleAcces.id}) }}" class="link-body-emphasis">
                                {{ acce.styleAcces.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_acces_show', {'id': acce.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_acces_edit', {'id': acce.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(acces) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_acces_new') }}" class="btn btn-primary">Créer nouvel accès</a>
        {% endif %}
    </div>
{% endblock %}
