{% extends 'base.html.twig' %}

{% block title %}Acces{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Accès</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_acces_edit', {'id': acce.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                    {{ include('acces/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ acce.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ acce.label }}</td>
                </tr>
                <tr>
                    <th>Numéro</th>
                    <td>{{ acce.numero }}</td>
                </tr>
                <tr>
                    <th>Accessible</th>
                    <td>{{ acce.isAccessible ? 'Oui' : 'Non' }}</td>
                </tr>
                <tr>
                    <th>Entrée</th>
                    <td>{{ acce.estEntree is null ? '—' : (acce.estEntree ? 'Oui' : 'Non') }}</td>
                </tr>
                <tr>
                    <th>Sortie</th>
                    <td>{{ acce.estSortie is null ? '—' : (acce.estSortie ? 'Oui' : 'Non') }}</td>
                </tr>
                <tr>
                    <th>Escalier mécanique</th>
                    <td>{{ acce.aEscalierMecanique is null ? '—' : (acce.aEscalierMecanique ? 'Oui' : 'Non') }}</td>
                </tr>
                <tr>
                    <th>Ascenseur</th>
                    <td>{{ acce.aAscenseur is null ? '—' : (acce.aAscenseur ? 'Oui' : 'Non') }}</td>
                </tr>
                <tr>
                    <th>Style</th>
                    <td>
                        {% if acce.styleAcces %}
                            <a href="{{ path('app_style_acces_show', {'id': acce.styleAcces.id}) }}" class="link-body-emphasis">
                                {{ acce.styleAcces.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Cheminement vers le quai le plus proche</h2>
        {% if acce.distanceMarcheMetres %}
            <table class="table">
                <tbody>
                    <tr>
                        <th>Distance</th>
                        <td>{{ acce.distanceMarcheMetres|round }} m</td>
                    </tr>
                    <tr>
                        <th>Temps de marche</th>
                        <td>{{ acce.tempsMarcheSecondes ? acce.tempsMarcheSecondes ~ ' s (~' ~ (acce.tempsMarcheSecondes / 60)|round(0, 'ceil') ~ ' min)' : '—' }}</td>
                    </tr>
                    <tr>
                        <th>Nombre de marches</th>
                        <td>{{ acce.nombreMarches ?? '—' }}</td>
                    </tr>
                    <tr>
                        <th>Pente maximale</th>
                        <td>{{ acce.penteMaxPourcent ? acce.penteMaxPourcent ~ ' %' : '—' }}</td>
                    </tr>
                    <tr>
                        <th>Largeur minimale</th>
                        <td>{{ acce.largeurMinMetres ? acce.largeurMinMetres ~ ' m' : '—' }}</td>
                    </tr>
                    <tr>
                        <th>Signalisation</th>
                        <td>{{ acce.signalisation ?? '—' }}</td>
                    </tr>
                    <tr>
                        <th>Cheminement</th>
                        <td>
                            {% if acce.cheminementBidirectionnel == false %}
                                <span class="badge text-bg-warning">Sens unique</span>
                            {% else %}
                                Bidirectionnel
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Cheminement non renseigné pour cet accès.</p>
        {% endif %}

        <h2 class="h5 mt-4 mb-3">Stations desservies</h2>

        {% if acce.stations|length > 0 %}
            <ul class="list-group mb-4">
                {% for station in acce.stations %}
                    <li class="list-group-item">
                        <a href="{{ path('app_station_show', {'id': station.id}) }}" class="link-body-emphasis">
                            {{ station.label }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune station enregistrée pour cet accès.</p>
        {% endif %}

        <a href="{{ path('app_acces_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
