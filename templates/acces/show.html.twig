{% extends 'base.html.twig' %}

{% block title %}Acces{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Accès</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ acce.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ acce.label }}</td>
                </tr>
                <tr>
                    <th>Numéro</th>
                    <td>{{ acce.numero }}</td>
                </tr>
                <tr>
                    <th>Accessible</th>
                    <td>{{ acce.isAccessible ? 'Oui' : 'Non' }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Stations desservies</h2>

        {% if acce.sorties|length > 0 %}
            <ul class="list-group mb-4">
                {% for sortie in acce.sorties %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        {% if sortie.station %}
                            <a href="{{ path('app_station_show', {'id': sortie.station.id}) }}" class="link-body-emphasis">
                                {{ sortie.station.label }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                        <a href="{{ path('app_sortie_show', {'id': sortie.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Aucune station enregistrée pour cet accès.</p>
        {% endif %}

        <div class="d-flex gap-2">
            <a href="{{ path('app_acces_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_acces_edit', {'id': acce.id}) }}" class="btn btn-warning">Modifier</a>
            {% endif %}
        </div>

        {{ include('acces/_delete_form.html.twig') }}
    </div>
{% endblock %}
