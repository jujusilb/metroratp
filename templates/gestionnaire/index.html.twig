{% extends 'base.html.twig' %}

{% block title %}Gestionnaires{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Gestionnaires</h1>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_gestionnaire_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'un gestionnaire',
        }) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(gestionnaires, 'Label', 'g.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for gestionnaire in gestionnaires %}
                <tr>
                    <td>{{ gestionnaire.label }}</td>
                    <td>
                        <a href="{{ path('app_gestionnaire_show', {'id': gestionnaire.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_gestionnaire_edit', {'id': gestionnaire.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(gestionnaires) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_gestionnaire_new') }}" class="btn btn-primary">Créer nouveau gestionnaire</a>
        {% endif %}
    </div>
{% endblock %}
