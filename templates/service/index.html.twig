{% extends 'base.html.twig' %}

{% block title %}Service{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Service</h1>

        {{ include('tools/filtre_alphabet.html.twig', {
            'route': 'app_service_index',
            'lettreSelectionnee': lettre,
            'recherche': recherche,
            'libelleRecherche': 'un service',
        }) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(services, 'Label', 's.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for service in services %}
                <tr>
                    <td>{{ service.label }}</td>
                    <td>
                        <a href="{{ path('app_service_show', {'id': service.id}) }}" class="btn btn-info btn-sm" title="Affichage" aria-label="Affichage"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_service_edit', {'id': service.id}) }}" class="btn btn-warning btn-sm" title="Modifier" aria-label="Modifier"><i class="bi bi-wrench"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(services) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_service_new') }}" class="btn btn-primary">Créer nouveau service</a>
        {% endif %}
    </div>
{% endblock %}
