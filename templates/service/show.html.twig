{% extends 'base.html.twig' %}

{% block title %}Service{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Service</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ service.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ service.label }}</td>
                </tr>
            </tbody>
        </table>

        <div class="d-flex gap-2">
            <a href="{{ path('app_service_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_service_edit', {'id': service.id}) }}" class="btn btn-warning">Modifier</a>
            {% endif %}
        </div>

        {{ include('service/_delete_form.html.twig') }}
    </div>
{% endblock %}
