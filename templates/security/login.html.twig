{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container py-4" style="max-width: 400px;">
        <h1 class="mb-4">Connexion</h1>

        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="mb-3">
                <label for="username" class="form-label">Nom d'utilisateur</label>
                <input type="text" name="_username" id="username" class="form-control" value="{{ last_username }}" autofocus required>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn-primary w-100">Se connecter</button>
        </form>

        <p class="text-muted small text-center mt-3">
            Pas encore de compte ? <a href="{{ path('app_inscription') }}">Créer un compte</a>
        </p>
    </div>
{% endblock %}
