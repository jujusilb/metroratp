{% extends 'base.html.twig' %}

{% block title %}Arrêts transporteur{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Arrêts transporteur</h1>
        <p class="text-muted">
            Référentiel officiel IDFM par arrêt physique (un poteau de bus, un quai précis) —
            accessibilité et signalisation sonore/visuelle officielles, distinctes des équipements
            OpenStreetMap (voir « Équipements des arrêts »).
        </p>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(arretsTransporteur, 'Nom', 'a.nom') }}</th>
                    <th>{{ knp_pagination_sortable(arretsTransporteur, 'Ville', 'a.ville') }}</th>
                    <th>{{ knp_pagination_sortable(arretsTransporteur, 'Type', 'a.type') }}</th>
                    <th>Accessible</th>
                    <th>Signal. sonore</th>
                    <th>Signal. visuelle</th>
                    <th>{{ knp_pagination_sortable(arretsTransporteur, 'Station rattachée', 'station.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for arret in arretsTransporteur %}
                <tr>
                    <td>{{ arret.nom }}</td>
                    <td>{{ arret.ville ?? '—' }}</td>
                    <td><span class="badge text-bg-light text-dark">{{ arret.type }}</span></td>
                    <td>
                        {% if arret.estAccessible is null %}
                            <span class="text-muted">—</span>
                        {% elseif arret.estAccessible %}
                            <span class="badge text-bg-success">Oui</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Non</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if arret.signalisationSonore is null %}
                            <span class="text-muted">—</span>
                        {% elseif arret.signalisationSonore %}
                            <span class="badge text-bg-success">Oui</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Non</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if arret.signalisationVisuelle is null %}
                            <span class="text-muted">—</span>
                        {% elseif arret.signalisationVisuelle %}
                            <span class="badge text-bg-success">Oui</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Non</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if arret.station %}
                            <a href="{{ path('app_station_show', {'id': arret.station.id}) }}">{{ arret.station.label }}</a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_arret_transporteur_show', {'id': arret.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_arret_transporteur_edit', {'id': arret.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(arretsTransporteur) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_arret_transporteur_new') }}" class="btn btn-primary">Créer un arrêt transporteur</a>
        {% endif %}
    </div>
{% endblock %}
