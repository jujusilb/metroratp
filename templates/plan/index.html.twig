{% extends 'base.html.twig' %}

{% block title %}Plans{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Plans</h1>
        {{ include('tools/_onglets.html.twig', {onglets: [
            {label: 'Secteur', route: 'app_plan_index', actif: true},
            {label: 'Région', route: 'app_plan_region_index', actif: false},
            {label: 'Ligne', route: 'app_document_ligne_index', actif: false},
        ]}) }}
        <p class="text-muted">Cartes schématiques papier IDFM couvrant chacune une portion du réseau. Le PDF officiel est hébergé par IDFM (lien ci-dessous), pas par ce site.</p>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(plans, 'Numéro', 'p.numero') }}</th>
                    <th>{{ knp_pagination_sortable(plans, 'Secteur', 'p.secteur') }}</th>
                    <th>{{ knp_pagination_sortable(plans, 'Département(s)', 'p.departements') }}</th>
                    <th>PDF</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for plan in plans %}
                <tr>
                    <td>{{ plan.numero }}</td>
                    <td>{{ plan.secteur }}</td>
                    <td>{{ plan.departements ?? '—' }}</td>
                    <td><a href="{{ plan.urlPdf }}" target="_blank" rel="noopener">Voir le PDF</a></td>
                    <td>
                        <a href="{{ path('app_plan_show', {'id': plan.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_plan_edit', {'id': plan.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(plans) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_plan_new') }}" class="btn btn-primary">Créer un plan de secteur</a>
        {% endif %}
    </div>
{% endblock %}
