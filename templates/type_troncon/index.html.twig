{% extends 'base.html.twig' %}

{% block title %}Types{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Types</h1>
        {{ include('tools/_onglets.html.twig', {onglets: [
            {label: 'Transport', route: 'app_type_transport_index', actif: false},
            {label: 'Matériel', route: 'app_type_materiel_index', actif: false},
            {label: 'Tronçon', route: 'app_type_troncon_index', actif: true},
        ]}) }}

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(type_troncons, 'Label', 't.label') }}</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for type_troncon in type_troncons %}
                <tr>
                    <td>{{ type_troncon.label }}</td>
                    <td>
                        <a href="{{ path('app_type_troncon_show', {'id': type_troncon.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_type_troncon_edit', {'id': type_troncon.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(type_troncons) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_type_troncon_new') }}" class="btn btn-primary">Créer nouveau type de tronçon</a>
        {% endif %}
    </div>
{% endblock %}
