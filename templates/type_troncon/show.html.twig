{% extends 'base.html.twig' %}

{% block title %}TypeTroncon{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Type de tronçon</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ type_troncon.id }}</td>
                </tr>
                <tr>
                    <th>Label</th>
                    <td>{{ type_troncon.label }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5 mt-4 mb-3">Tronçons de ce type</h2>

        {% if type_troncon.troncons|length > 0 %}
            <table class="table align-middle mb-4">
                <thead>
                    <tr>
                        <th>Distance</th>
                        <th>Départ</th>
                        <th>Arrivée</th>
                        <th>Direction</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for troncon in type_troncon.troncons %}
                    {% set sens = troncon.sensCirculation %}
                    {% if sens|length > 0 %}
                        {% for s in sens %}
                            <tr>
                                {% if loop.first %}
                                    <td rowspan="{{ sens|length }}">{{ troncon.distance ? troncon.distance|round ~ ' m' : '—' }}</td>
                                {% endif %}
                                <td>
                                    {% if s.depart and s.depart.station %}
                                        <a href="{{ path('app_station_show', {'id': s.depart.station.id}) }}" class="link-body-emphasis">{{ s.depart.station.label }}</a>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if s.arrivee and s.arrivee.station %}
                                        <a href="{{ path('app_station_show', {'id': s.arrivee.station.id}) }}" class="link-body-emphasis">{{ s.arrivee.station.label }}</a>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if s.direction and s.direction.station %}
                                        <span class="text-muted">{{ s.direction.station.label }}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                {% if loop.first %}
                                    <td rowspan="{{ sens|length }}">
                                        <a href="{{ path('app_troncon_show', {'id': troncon.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td>{{ troncon.distance ? troncon.distance|round ~ ' m' : '—' }}</td>
                            <td colspan="3" class="text-muted">Aucun sens de circulation enregistré</td>
                            <td>
                                <a href="{{ path('app_troncon_show', {'id': troncon.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucun tronçon enregistré pour ce type.</p>
        {% endif %}

        <div class="d-flex gap-2">
            <a href="{{ path('app_type_troncon_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_type_troncon_edit', {'id': type_troncon.id}) }}" class="btn btn-warning">Modifier</a>
            {% endif %}
        </div>

        {{ include('type_troncon/_delete_form.html.twig') }}
    </div>
{% endblock %}
