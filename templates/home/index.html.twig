{% extends 'base.html.twig' %}

{% block title %}Métro RATP{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold">Métro de Paris</h1>
            <p class="lead text-muted">
                Une base de données complète du réseau du métro parisien : lignes, stations, tronçons,
                correspondances, matériel roulant et missions — et un calculateur de trajet au plus court chemin.
            </p>
            <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg mt-2">Se connecter</a>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">Réseau détaillé</h2>
                        <p class="card-text text-muted">
                            Lignes, stations, tronçons et correspondances, avec leurs temps de parcours réels
                            issus des données GTFS Île-de-France Mobilités.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">Calcul de trajet</h2>
                        <p class="card-text text-muted">
                            Plus court chemin entre deux stations (algorithme de Dijkstra), affiché sur le plan
                            schématique officiel du réseau.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">Exploitation</h2>
                        <p class="card-text text-muted">
                            Matériel roulant, missions et services, pour explorer le fonctionnement quotidien
                            du réseau.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
