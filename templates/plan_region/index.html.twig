{% extends 'base.html.twig' %}

{% block title %}Plans{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">Plans</h1>
        {{ include('tools/_onglets.html.twig', {onglets: [
            {label: 'Secteur', route: 'app_plan_index', actif: false},
            {label: 'Région', route: 'app_plan_region_index', actif: true},
            {label: 'Ligne', route: 'app_document_ligne_index', actif: false},
        ]}) }}
        <p class="text-muted">Grandes cartes d'ensemble du réseau (Métro, RER, réseau de Nuit, plans PMR/facile à lire...).</p>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>{{ knp_pagination_sortable(plans_region, 'Nom', 'p.label') }}</th>
                    <th>{{ knp_pagination_sortable(plans_region, 'Date de publication', 'p.datePublication') }}</th>
                    <th>PDF</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for plan_region in plans_region %}
                <tr>
                    <td>{{ plan_region.label }}</td>
                    <td>{{ plan_region.datePublication ?? '—' }}</td>
                    <td><a href="{{ plan_region.urlPdf }}" target="_blank" rel="noopener">Voir le PDF</a></td>
                    <td>
                        <a href="{{ path('app_plan_region_show', {'id': plan_region.id}) }}" class="btn btn-info btn-sm">Affichage</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_plan_region_edit', {'id': plan_region.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {{ knp_pagination_render(plans_region) }}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_plan_region_new') }}" class="btn btn-primary">Créer un plan régional</a>
        {% endif %}
    </div>
{% endblock %}
