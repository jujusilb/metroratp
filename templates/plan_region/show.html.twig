{% extends 'base.html.twig' %}

{% block title %}Plan régional {{ plan_region.label }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1 class="mb-4">{{ plan_region.label }}</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Fiche IDFM</th>
                    <td>
                        {% if plan_region.urlFiche %}
                            <a href="{{ plan_region.urlFiche }}" target="_blank" rel="noopener">{{ plan_region.urlFiche }}</a>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Taille du fichier</th>
                    <td>{{ plan_region.tailleFichierMo ? plan_region.tailleFichierMo ~ ' Mo' : '—' }}</td>
                </tr>
                <tr>
                    <th>Date de publication</th>
                    <td>{{ plan_region.datePublication ?? '—' }}</td>
                </tr>
                <tr>
                    <th>Format</th>
                    <td>{{ plan_region.format ?? '—' }}</td>
                </tr>
            </tbody>
        </table>

        <h2 class="h5">Plan</h2>
        {{ include('tools/visionneuse_pdf.html.twig', {'url': plan_region.urlPdf}) }}

        <div class="d-flex gap-2 mt-4">
            <a href="{{ path('app_plan_region_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_plan_region_edit', {'id': plan_region.id}) }}" class="btn btn-warning">Modifier</a>
            {% endif %}
        </div>

        {{ include('plan_region/_delete_form.html.twig') }}
    </div>
{% endblock %}
